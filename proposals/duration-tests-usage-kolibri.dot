digraph DurationTestsUsageKolibri {
  rankdir=TB;
  size="16,9!";
  ratio=fill;
  bgcolor="white";
  pad="0.35";
  nodesep="0.35";
  ranksep="0.55";
  fontname="Helvetica";
  splines=true;
  overlap=false;
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10, width=1.35, height=0.48, margin="0.08,0.06"];
  edge [fontname="Helvetica", fontsize=7, color="#555555"];

  start [label="start", shape=circle, width=0.40, height=0.40, fixedsize=true, fillcolor="#eeeeee", style=filled, fontsize=9];
  start_return [label="", shape=circle, width=0.28, height=0.28, fixedsize=true, fillcolor="black", style=filled, color="black", xlabel="Return to start"];

  subgraph cluster_console {
    label="Console";
    fontsize=11;
    style=rounded;
    color="#5DADE2";
    console_teacher [label="console_teacher\n(teacher)", fillcolor="#D6EAF8"];
    console_learner  [label="console_learner\n(student)", fillcolor="#85C1E9"];
  }

  subgraph cluster_kolibri {
    label="Kolibri";
    fontsize=11;
    style=rounded;
    color="#58D68D";
    kolibri_home     [label="kolibri_home", fillcolor="#D5F5E3"];
    kolibri_watching [label="kolibri_watching", fillcolor="#D5F5E3"];
    kolibri_exercise [label="kolibri_exercise", fillcolor="#D5F5E3"];
    kolibri_manage   [label="kolibri_manage\n(teacher)", fillcolor="#ABEBC6"];
  }

  start -> console_teacher [label="Open Console\nas teacher"];
  start -> console_learner  [label="Open Console\nas learner"];

  console_teacher -> kolibri_manage   [label="Open Kolibri as teacher 0.20"];
  console_teacher -> console_teacher  [label="Stay on teacher overview 0.50"];
  console_learner -> kolibri_home     [label="Open Kolibri as learner 0.40"];
  console_learner -> console_learner  [label="Stay on learner overview 0.15"];

  kolibri_manage -> kolibri_manage   [label="Create class 0.12"];
  kolibri_manage -> kolibri_manage   [label="Enroll learners 0.12"];
  kolibri_manage -> kolibri_manage   [label="Build lesson 0.14"];
  kolibri_manage -> kolibri_manage   [label="Create quiz 0.09"];
  kolibri_manage -> kolibri_manage   [label="Read reports 0.08"];
  kolibri_manage -> kolibri_home     [label="Preview as learner 0.20"];
  kolibri_manage -> console_teacher  [label="Back to Console 0.25"];

  kolibri_home -> kolibri_watching [label="Open video 0.45"];
  kolibri_home -> kolibri_exercise [label="Open exercise 0.25"];
  kolibri_home -> kolibri_home     [label="Browse classes 0.20"];
  kolibri_home -> console_learner  [label="Leave Kolibri 0.10"];

  kolibri_watching -> kolibri_watching [label="Keep watching 0.60"];
  kolibri_watching -> kolibri_exercise [label="Next resource 0.25"];
  kolibri_watching -> kolibri_home     [label="Exit lesson 0.15"];

  kolibri_exercise -> kolibri_home     [label="Finish exercise 0.70"];
  kolibri_exercise -> kolibri_watching [label="Next video 0.30"];

  console_teacher -> start_return [label="Return to start 0.05", style=dashed, color="#333333"];
  console_learner -> start_return [label="Return to start 0.05", style=dashed, color="#333333"];
  kolibri_home -> start_return [label="Return to start 0.05", style=dashed, color="#333333"];
  kolibri_watching -> start_return [label="Return to start 0.05", style=dashed, color="#333333"];
  kolibri_exercise -> start_return [label="Return to start 0.05", style=dashed, color="#333333"];
  kolibri_manage -> start_return [label="Return to start 0.05", style=dashed, color="#333333"];
}
