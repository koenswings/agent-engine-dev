digraph DurationTestsUsageFiles {
  rankdir=TB;
  size="16,9!";
  ratio=fill;
  bgcolor="white";
  pad="0.35";
  nodesep="0.35";
  ranksep="0.55";
  fontname="Helvetica";
  splines=true;
  overlap=false;
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10, width=1.35, height=0.48, margin="0.08,0.06"];
  edge [fontname="Helvetica", fontsize=7, color="#555555"];

  start [label="start", shape=circle, width=0.40, height=0.40, fixedsize=true, fillcolor="#eeeeee", style=filled, fontsize=9];
subgraph cluster_console {
    label="Console";
    fontsize=11;
    style=rounded;
    color="#5DADE2";
    console_teacher [label="console_teacher\n(teacher)", fillcolor="#D6EAF8"];
    console_learner  [label="console_learner\n(student)", fillcolor="#85C1E9"];
  }

  subgraph cluster_nextcloud {
    label="Nextcloud";
    fontsize=11;
    style=rounded;
    color="#F4D03F";
    nc_browse [label="nc_browse", fillcolor="#FCF3CF"];
    nc_share  [label="nc_share\n(teacher)", fillcolor="#F9E79F"];
    nc_drop   [label="nc_drop\n(student)", fillcolor="#F9E79F"];
    nc_collab [label="nc_collab", fillcolor="#F9E79F"];
  }

  subgraph cluster_wiki {
    label="Wikipedia / Kiwix";
    fontsize=11;
    style=rounded;
    color="#AF7AC5";
    wiki_browse [label="wiki_browse", fillcolor="#E8DAEF"];
  }

  start -> console_teacher [label="Open Console\nas teacher"];
  start -> console_learner  [label="Open Console\nas learner"];

  console_teacher -> nc_browse        [label="Open Nextcloud as teacher 0.20"];
  console_teacher -> wiki_browse      [label="Open Wikipedia as teacher 0.10"];
  console_teacher -> console_teacher  [label="Stay on teacher overview 0.50"];

  console_learner -> nc_browse        [label="Open Nextcloud as learner 0.25"];
  console_learner -> wiki_browse      [label="Open Wikipedia as learner 0.20"];
  console_learner -> console_learner  [label="Stay on learner overview 0.15"];

  nc_browse -> nc_share         [label="Share to class 0.18"];
  nc_browse -> nc_drop          [label="Open File Drop 0.22"];
  nc_browse -> nc_collab        [label="Open collab doc 0.22"];
  nc_browse -> nc_browse        [label="Browse folders 0.15"];
  nc_browse -> console_learner  [label="Leave Nextcloud as learner 0.13"];
  nc_browse -> console_teacher  [label="Leave Nextcloud as teacher 0.10"];

  nc_share -> nc_browse        [label="Done sharing 0.80"];
  nc_share -> console_teacher  [label="Back to Console from share 0.20"];

  nc_drop -> nc_browse        [label="After upload 0.85"];
  nc_drop -> console_learner  [label="Leave File Drop 0.15"];

  nc_collab -> nc_browse [label="Close doc 0.70"];
  nc_collab -> nc_collab [label="Keep editing 0.30"];

  wiki_browse -> wiki_browse      [label="Search / browse Wikipedia 0.65"];
  wiki_browse -> console_learner  [label="Leave Wikipedia as learner 0.20"];
  wiki_browse -> console_teacher  [label="Leave Wikipedia as teacher 0.15"];

  // Per-state Return-to-start shortcuts (dedicated black circles)
  console_learner_ret [label="", shape=circle, width=0.18, height=0.18, fixedsize=true, fillcolor="black", style=filled, color="black"];
  console_learner -> console_learner_ret [label="0.05", style=dashed, color="#333333", arrowsize=0.6, minlen=1];
  console_teacher_ret [label="", shape=circle, width=0.18, height=0.18, fixedsize=true, fillcolor="black", style=filled, color="black"];
  console_teacher -> console_teacher_ret [label="0.05", style=dashed, color="#333333", arrowsize=0.6, minlen=1];
  nc_browse_ret [label="", shape=circle, width=0.18, height=0.18, fixedsize=true, fillcolor="black", style=filled, color="black"];
  nc_browse -> nc_browse_ret [label="0.05", style=dashed, color="#333333", arrowsize=0.6, minlen=1];
  nc_collab_ret [label="", shape=circle, width=0.18, height=0.18, fixedsize=true, fillcolor="black", style=filled, color="black"];
  nc_collab -> nc_collab_ret [label="0.05", style=dashed, color="#333333", arrowsize=0.6, minlen=1];
  nc_drop_ret [label="", shape=circle, width=0.18, height=0.18, fixedsize=true, fillcolor="black", style=filled, color="black"];
  nc_drop -> nc_drop_ret [label="0.05", style=dashed, color="#333333", arrowsize=0.6, minlen=1];
  nc_share_ret [label="", shape=circle, width=0.18, height=0.18, fixedsize=true, fillcolor="black", style=filled, color="black"];
  nc_share -> nc_share_ret [label="0.05", style=dashed, color="#333333", arrowsize=0.6, minlen=1];
  wiki_browse_ret [label="", shape=circle, width=0.18, height=0.18, fixedsize=true, fillcolor="black", style=filled, color="black"];
  wiki_browse -> wiki_browse_ret [label="0.05", style=dashed, color="#333333", arrowsize=0.6, minlen=1];
}
