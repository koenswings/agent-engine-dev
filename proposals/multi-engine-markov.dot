digraph MultiEngineMarkov {
  rankdir=LR;
  bgcolor="white";
  pad="0.4";
  nodesep="0.45";
  ranksep="0.75";
  fontname="Helvetica";
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11, width=1.6, height=0.55];
  edge [fontname="Helvetica", fontsize=8, color="#555555"];

  // Start
  start [label="*", shape=circle, width=0.35, height=0.35, fixedsize=true, fillcolor="#eeeeee", style=filled];

  // Console (split: teacher/operator vs learner)
  console_overview [label="console_overview\n(teacher / operator)", fillcolor="#D6EAF8"];
  console_learner  [label="console_learner\n(student)", fillcolor="#85C1E9"];

  // Kolibri
  kolibri_home     [label="kolibri_home", fillcolor="#D5F5E3"];
  kolibri_watching [label="kolibri_watching", fillcolor="#D5F5E3"];
  kolibri_exercise [label="kolibri_exercise", fillcolor="#D5F5E3"];
  kolibri_manage   [label="kolibri_manage\n(teacher)", fillcolor="#ABEBC6"];

  // Nextcloud
  nc_browse [label="nc_browse", fillcolor="#FCF3CF"];
  nc_share  [label="nc_share\n(teacher)", fillcolor="#F9E79F"];
  nc_drop   [label="nc_drop\n(student)", fillcolor="#F9E79F"];
  nc_collab [label="nc_collab", fillcolor="#F9E79F"];

  // Wikipedia / Kiwix (idea-A)
  wiki_browse [label="wiki_browse\n(Kiwix / Wikipedia)", fillcolor="#E8DAEF"];

  // Entry
  start -> console_overview [label="teacher / op"];
  start -> console_learner  [label="learner"];

  // Teacher Console
  console_overview -> kolibri_manage [label="open Kolibri 0.20\n[K-manage-*]"];
  console_overview -> nc_browse      [label="open Nextcloud 0.20\n[NC1 / NC-share]"];
  console_overview -> wiki_browse    [label="open Wikipedia 0.10\n[W1]"];
  console_overview -> console_overview [label="dwell / refresh 0.50"];

  // Learner Console
  console_learner -> kolibri_home  [label="open Kolibri 0.40\n[L-entry]"];
  console_learner -> nc_browse     [label="open Nextcloud 0.25\n[L-entry]"];
  console_learner -> wiki_browse   [label="open Wikipedia 0.20\n[L-entry / W1]"];
  console_learner -> console_learner [label="dwell 0.15"];

  // Kolibri manage
  kolibri_manage -> kolibri_home     [label="preview as learner 0.20"];
  kolibri_manage -> kolibri_manage   [label="edit / reports 0.55\n[K-manage-*]"];
  kolibri_manage -> console_overview [label="back to Console 0.25"];

  // Kolibri learner path
  kolibri_home -> kolibri_watching [label="open video 0.45\n[K2]"];
  kolibri_home -> kolibri_exercise [label="open exercise 0.25\n[K2]"];
  kolibri_home -> kolibri_home     [label="browse classes 0.20"];
  kolibri_home -> console_learner  [label="leave 0.10"];

  kolibri_watching -> kolibri_watching [label="keep watching 0.60\n[K3]"];
  kolibri_watching -> kolibri_exercise [label="next resource 0.25"];
  kolibri_watching -> kolibri_home     [label="exit lesson 0.15"];

  kolibri_exercise -> kolibri_home     [label="finish / exit 0.70"];
  kolibri_exercise -> kolibri_watching [label="next video 0.30"];

  // Nextcloud
  nc_browse -> nc_share          [label="share to class 0.18\n[NC-share]"];
  nc_browse -> nc_drop           [label="File Drop 0.22\n[NC-drop]"];
  nc_browse -> nc_collab         [label="open collab 0.22\n[NC-collab]"];
  nc_browse -> nc_browse         [label="browse folders 0.15"];
  nc_browse -> console_learner   [label="leave (learner) 0.13"];
  nc_browse -> console_overview  [label="leave (teacher) 0.10"];

  nc_share -> nc_browse         [label="done sharing 0.80"];
  nc_share -> console_overview  [label="leave 0.20"];

  nc_drop -> nc_browse        [label="after upload 0.85"];
  nc_drop -> console_learner  [label="leave 0.15"];

  nc_collab -> nc_browse  [label="close doc 0.70"];
  nc_collab -> nc_collab  [label="keep editing 0.30"];

  // Wikipedia
  wiki_browse -> wiki_browse       [label="search / browse 0.65\n[W1]"];
  wiki_browse -> console_learner   [label="leave (learner) 0.20"];
  wiki_browse -> console_overview  [label="leave (teacher) 0.15"];

  // Legend
  subgraph cluster_legend {
    label="Legend";
    fontsize=10;
    style=dashed;
    color="#aaaaaa";
    node [width=1.35, height=0.4, fontsize=9];
    L1 [label="Console (teacher)", fillcolor="#D6EAF8"];
    L1b [label="Console (learner)", fillcolor="#85C1E9"];
    L2 [label="Kolibri", fillcolor="#D5F5E3"];
    L3 [label="Nextcloud", fillcolor="#FCF3CF"];
    L4 [label="Wikipedia / Kiwix", fillcolor="#E8DAEF"];
    L1 -> L1b -> L2 -> L3 -> L4 [style=invis];
  }
}
