#!/bin/bash
# idea-flash-card — write a verified IDEA client image to a removable card or USB disk (idea#201 §10, idea#303)
#
# Installed as a root-owned COPY at /usr/local/sbin/idea-flash-card (never a symlink).
# Allowed by sudoers with no argument list; this script re-checks EVERYTHING itself
# and does not trust the Engine.
#
# Usage:
#   idea-flash-card --by-id <path> --expect-device <sdX> --expect-size <bytes> \
#                   --image <file> --sha256 <hex> [--os-rootfs <sdXN>]... [--timezone <Area/City>] [--home <engine-name>]
#   idea-flash-card --version
#
#   --by-id         /dev/disk/by-id/usb-...  (whole disk link, never a -partN link)
#   --expect-device sdX the by-id link must resolve to (what the Engine saw)
#   --expect-size   bytes; must equal the device size now (dialog → write binding)
#   --image         /var/lib/idea/client-images/<version>/idea-client-<version>.img.xz
#   --sha256        64 hex; must equal the image's .sha256 file AND the recomputed hash
#   --os-rootfs     sdXN (partition 1 or 2 of --expect-device), repeatable: the Engine found an OS
#                   root filesystem layout on it with hasOsRootfsLayout (src/monitors/mounts.ts, idea#279),
#                   so a META.yaml there is an old Engine system disk, not an IDEA disk (idea#303).
#                   The layout check lives only in the Engine; this helper does not repeat it.
#   --timezone      the Engine's own tz name (idea#208). Re-validated here (regex, no '..', must be a
#                   file under /usr/share/zoneinfo; BAD_ARGS before anything is touched). After the
#                   read-back matched and before flush + power-off, idea-write-card-timezone writes
#                   idea-timezone.txt = "<zone>\n" on FAT partition 1. A failure of that step does
#                   not fail the flash (the client stays on UTC): it is reported on stderr as
#                   "warning: TIMEZONE_FAILED: ..." and as "timezoneFile":"failed" in the result.
#                   Without --timezone no file is written ("timezoneFile":"skipped").
#   --home          the home-Engine name, e.g. brave-otter (idea#203 §2, v4). Re-validated here
#                   ([a-z0-9-], 1-63, no leading/trailing hyphen; BAD_ARGS before anything is touched).
#                   After the verified write, idea-write-home-engine writes idea-home.txt =
#                   "<name>.local\n" on FAT partition 1. Same failure rule as --timezone:
#                   "warning: HOME_FAILED: ..." and "homeFile":"written|skipped|failed".
#
# Output: JSON lines on stdout {"step":..,"bytes":..,"total":..}, last line
#   {"result":"ok","bytesWritten":N,"sha256":"..","readBackSha256":"..","safeToRemove":true|false,
#    "timezoneFile":"written|skipped|failed","homeFile":"written|skipped|failed"}
# Exit: 0 ok (incl. POWER_OFF_FAILED → safeToRemove false), 2 refused (stderr "refused: CODE: text"),
#       3 failed (stderr "failed: CODE: text"). SIGTERM → failed CANCELLED.
# Never mounts anything itself (idea-write-card-timezone / idea-write-home-engine mount partition 1 for --timezone / --home). No size limit (any card size; only IMAGE_TOO_LARGE is physical).

set -u
PATH=/usr/sbin:/usr/bin:/sbin:/bin
VERSION=4
IMAGES_ROOT=/var/lib/idea/client-images
ZONEINFO=/usr/share/zoneinfo
TZ_WRITER=/usr/local/sbin/idea-write-card-timezone
HOME_WRITER=/usr/local/sbin/idea-write-home-engine

refuse() { echo "refused: $1: $2" >&2; exit 2; }
fail()   { echo "failed: $1: $2" >&2; cleanup_children; try_power_off >/dev/null; exit 3; }
emit()   { printf '{"step":"%s","bytes":%s,"total":%s}\n' "$1" "${2:-0}" "${3:-0}"; }

if [[ "${1:-}" == "--version" ]]; then echo "idea-flash-card $VERSION"; exit 0; fi

BYID= DEV= SIZE= IMAGE= SHA= TZONE= TZ_SET=0 HOMENAME= HOME_SET=0
OSROOTFS=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --by-id) BYID="${2:-}"; shift 2 ;;
    --expect-device) DEV="${2:-}"; shift 2 ;;
    --expect-size) SIZE="${2:-}"; shift 2 ;;
    --image) IMAGE="${2:-}"; shift 2 ;;
    --sha256) SHA="${2:-}"; shift 2 ;;
    --os-rootfs) OSROOTFS+=("${2:-}"); shift 2 ;;
    --timezone) TZONE="${2:-}"; TZ_SET=1; shift 2 ;;
    --home) HOMENAME="${2:-}"; HOME_SET=1; shift 2 ;;
    *) refuse BAD_ARGS "unknown argument '$1'" ;;
  esac
done
[[ "$BYID" =~ ^/dev/disk/by-id/usb-[A-Za-z0-9_.:-]+$ ]] || refuse BAD_ARGS "by-id must be /dev/disk/by-id/usb-..."
[[ "$BYID" =~ -part[0-9]+$ ]] && refuse BAD_ARGS "by-id must name the whole disk, not a partition"
[[ "$DEV" =~ ^sd[a-z]$ ]] || refuse BAD_ARGS "expect-device must be sdX"
[[ "$SIZE" =~ ^[0-9]+$ && "$SIZE" -gt 0 ]] || refuse BAD_ARGS "expect-size must be digits"
[[ "$SHA" =~ ^[0-9a-f]{64}$ ]] || refuse BAD_ARGS "sha256 must be 64 lower-case hex"
for p in "${OSROOTFS[@]}"; do [[ "$p" =~ ^${DEV}[12]$ ]] || refuse BAD_ARGS "os-rootfs must be partition 1 or 2 of $DEV"; done
[[ "$IMAGE" =~ ^$IMAGES_ROOT/([A-Za-z0-9._-]+)/idea-client-([A-Za-z0-9._-]+)\.img\.xz$ ]] || refuse BAD_ARGS "image must be $IMAGES_ROOT/<version>/idea-client-<version>.img.xz"
[[ "${BASH_REMATCH[1]}" == "${BASH_REMATCH[2]}" ]] || refuse BAD_ARGS "image folder and file version differ"
# >>> tz-check (idea#208): runs as root, so never trust the Engine's zone
if [[ $TZ_SET -eq 1 ]]; then
  [[ "$TZONE" =~ ^[A-Za-z][A-Za-z0-9_+-]*(/[A-Za-z0-9_+-]+){0,2}$ ]] || refuse BAD_ARGS "timezone '$TZONE' is not a tz database name"
  case "/$TZONE/" in */../*|*/./*) refuse BAD_ARGS "timezone '$TZONE' has a . or .. component" ;; esac
  [[ -f "$ZONEINFO/$TZONE" ]] || refuse BAD_ARGS "timezone '$TZONE' is not in $ZONEINFO"
fi
# <<< tz-check
# >>> home-check (idea#203 §2): same rule as idea-write-home-engine
if [[ $HOME_SET -eq 1 ]]; then
  [[ "$HOMENAME" =~ ^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$ ]] || refuse BAD_ARGS "home '$HOMENAME' must be 1-63 of a-z 0-9 -, no leading or trailing hyphen"
fi
# <<< home-check
check="$IMAGE"; while [[ "$check" != "/" ]]; do [[ -L "$check" ]] && refuse BAD_ARGS "image path contains a symlink ($check)"; check=$(dirname "$check"); done

DEVPATH="/dev/$DEV"
DD_PID= HASH_PID= WATCH_PID= TMPD=$(mktemp -d)
cleanup_children() {
  for p in $WATCH_PID $DD_PID $HASH_PID; do kill "$p" 2>/dev/null; done
  pkill -P $$ 2>/dev/null; wait 2>/dev/null
}
try_power_off() {
  sync
  blockdev --flushbufs "$DEVPATH" 2>/dev/null
  if [[ -w "/sys/block/$DEV/device/delete" ]] && echo 1 > "/sys/block/$DEV/device/delete" 2>/dev/null; then echo true; else echo false; fi
}
trap 'echo "failed: CANCELLED: flash cancelled" >&2; cleanup_children; try_power_off >/dev/null; rm -rf "$TMPD"; exit 3' TERM INT
trap 'rm -rf "$TMPD"' EXIT

resolve_ok() {   # by-id still points at the same whole disk with the same size
  local r s
  r=$(readlink -f "$BYID" 2>/dev/null) || return 1
  [[ "$r" == "$DEVPATH" ]] || return 1
  s=$(blockdev --getsize64 "$DEVPATH" 2>/dev/null) || return 1
  [[ "$s" == "$SIZE" ]]
}

# ── Checks (authoritative) ──────────────────────────────────────────────────
emit checking 0 0
[[ -L "$BYID" ]] || refuse NOT_FOUND "$BYID does not exist"
resolve_ok || {
  [[ "$(readlink -f "$BYID")" == "$DEVPATH" ]] && refuse SIZE_CHANGED "size of $DEVPATH is not $SIZE"
  refuse MEDIUM_SWAPPED "$BYID no longer resolves to $DEVPATH"
}
[[ "$(lsblk -dn -o TYPE "$DEVPATH" | tr -d '[:space:]')" == "disk" ]] || refuse BAD_ARGS "$DEVPATH is not a whole disk"
rm_flag=$(cat "/sys/block/$DEV/removable" 2>/dev/null || echo 0)
tran=$(lsblk -dn -o TRAN "$DEVPATH" | tr -d '[:space:]')
# idea#303: a USB SSD/HDD (removable=0, tran=usb) is a valid client-image target too
[[ "$rm_flag" == "1" || "$tran" == "usb" ]] || refuse NOT_REMOVABLE "$DEVPATH is neither removable media nor a USB disk (removable=$rm_flag, tran=$tran)"
for mp in / /boot/firmware /boot; do
  src=$(findmnt -n -o SOURCE "$mp" 2>/dev/null | head -1); [[ -n "$src" ]] || continue
  src=${src%%[*}; pk=$(lsblk -no PKNAME "$src" 2>/dev/null | head -1 | tr -d '[:space:]')
  [[ -z "$pk" ]] && pk=$(basename "$src")
  [[ "$pk" == "$DEV" ]] && { [[ "$mp" == "/" ]] && refuse SYSTEM_DISK "$DEVPATH holds /"; refuse BOOT_DEVICE "$DEVPATH holds $mp"; }
done
while read -r name mnt; do
  [[ -n "${mnt:-}" ]] && refuse MOUNTED "/dev/$name is mounted on $mnt"
done < <(lsblk -ln -o NAME,MOUNTPOINT "$DEVPATH")
if grep -q "^/dev/$DEV" /proc/swaps; then refuse MOUNTED "$DEVPATH holds active swap"; fi
shopt -s nullglob; holders=(/sys/block/$DEV/holders/* /sys/block/$DEV/$DEV*/holders/*); shopt -u nullglob
[[ ${#holders[@]} -eq 0 ]] || refuse IN_USE_BY_APP "$DEVPATH has holders (${holders[*]})"
# IDEA META on any ext4 partition (read without mounting): never a flash target, unless the
# Engine named that partition with --os-rootfs (an old Engine system disk, idea#303)
# >>> meta-check
while read -r name fst; do
  [[ "$fst" == "ext4" ]] || continue
  if debugfs -R "stat /META.yaml" "/dev/$name" 2>/dev/null | grep -q "^Inode:"; then
    rootfs_ok=0; for p in "${OSROOTFS[@]}"; do [[ "$p" == "$name" ]] && rootfs_ok=1; done
    [[ $rootfs_ok -eq 1 ]] || refuse HAS_IDEA_META "/dev/$name has an IDEA META.yaml"
  fi
done < <(lsblk -ln -o NAME,FSTYPE "$DEVPATH" | tail -n +2)
# <<< meta-check

# ── Image ───────────────────────────────────────────────────────────────────
emit verifying-image 0 0
[[ -f "$IMAGE" ]] || refuse IMAGE_NOT_FOUND "$IMAGE missing"
[[ -f "$IMAGE.sha256" ]] || refuse IMAGE_NOT_FOUND "$IMAGE.sha256 missing"
read -r file_sha file_name < "$IMAGE.sha256"
[[ "$file_sha" == "$SHA" ]] || refuse IMAGE_BAD_SHA ".sha256 file does not match the requested sha256"
[[ "${file_name#\*}" == "$(basename "$IMAGE")" ]] || refuse IMAGE_BAD_SHA ".sha256 names '${file_name}', not $(basename "$IMAGE")"
calc=$(sha256sum "$IMAGE" | cut -d' ' -f1)
[[ "$calc" == "$SHA" ]] || refuse IMAGE_BAD_SHA "recomputed sha256 $calc differs"
usize=$(xz --robot --list "$IMAGE" 2>/dev/null | awk '$1=="totals"{print $5}')
[[ "$usize" =~ ^[0-9]+$ ]] || refuse IMAGE_BAD_SHA "cannot read the uncompressed size (xz --list)"
[[ "$usize" -le "$SIZE" ]] || refuse IMAGE_TOO_LARGE "image needs $usize bytes, card has $SIZE"

# ── Write ───────────────────────────────────────────────────────────────────
resolve_ok || refuse MEDIUM_SWAPPED "$BYID changed before the write"
exec 9<>"$DEVPATH" || refuse BUSY "cannot open $DEVPATH"
flock -x -n 9 || refuse BUSY "$DEVPATH is locked by another process"
emit writing 0 "$usize"
mkfifo "$TMPD/f"
sha256sum < "$TMPD/f" > "$TMPD/written.sha" & HASH_PID=$!
( xz -dc "$IMAGE" | tee "$TMPD/f" | dd of="$DEVPATH" bs=4M iflag=fullblock oflag=direct conv=fsync status=none ) 2>"$TMPD/dd.err" & DD_PID=$!
( while sleep 2; do resolve_ok || { echo swapped > "$TMPD/swapped"; kill $DD_PID 2>/dev/null; pkill -P $DD_PID 2>/dev/null; exit; }; done ) & WATCH_PID=$!
base=$(awk '{print $7*512}' /sys/block/$DEV/stat 2>/dev/null || echo 0)
last=0
while kill -0 $DD_PID 2>/dev/null; do
  sleep 1
  done_b=$(awk -v b="$base" '{print $7*512-b}' /sys/block/$DEV/stat 2>/dev/null)
  [[ -n "$done_b" && "$done_b" != "$last" ]] && { emit writing "$done_b" "$usize"; last=$done_b; }
done
wait $DD_PID; rc=$?
kill $WATCH_PID 2>/dev/null; wait $WATCH_PID 2>/dev/null; WATCH_PID=
wait $HASH_PID; HASH_PID=
[[ -f "$TMPD/swapped" ]] && fail MEDIUM_SWAPPED "$BYID changed during the write"
[[ $rc -eq 0 ]] || fail WRITE_FAILED "$(tail -c 300 "$TMPD/dd.err" | tr '\n' ' ')"
wsha=$(cut -d' ' -f1 "$TMPD/written.sha")
resolve_ok || fail MEDIUM_SWAPPED "$BYID changed after the write"

# ── Read back ───────────────────────────────────────────────────────────────
emit reading-back 0 "$usize"
blockdev --flushbufs "$DEVPATH"
echo 3 > /proc/sys/vm/drop_caches
rsha=$(head -c "$usize" "$DEVPATH" | sha256sum | cut -d' ' -f1)
emit reading-back "$usize" "$usize"
[[ "$rsha" == "$wsha" ]] || fail VERIFY_FAILED "read-back $rsha differs from written $wsha"

# ── Client time zone (idea#208): idea-timezone.txt on FAT partition 1 ─────
tzfile=skipped
if [[ $TZ_SET -eq 1 ]]; then
  blockdev --rereadpt "$DEVPATH" 2>/dev/null || partx -u "$DEVPATH" 2>/dev/null || true
  udevadm settle --timeout=10 >/dev/null 2>&1 || true
  if tzout=$("$TZ_WRITER" "$BYID" "$DEVPATH" "$SIZE" "$TZONE" 2>&1); then tzfile=written
  else tzfile=failed; echo "warning: TIMEZONE_FAILED: $(echo "$tzout" | tail -n 1)" >&2; fi
fi

homefile=skipped
if [[ $HOME_SET -eq 1 ]]; then
  if [[ $TZ_SET -ne 1 ]]; then
    blockdev --rereadpt "$DEVPATH" 2>/dev/null || partx -u "$DEVPATH" 2>/dev/null || true
    udevadm settle --timeout=10 >/dev/null 2>&1 || true
  fi
  if hout=$("$HOME_WRITER" "$BYID" "$DEVPATH" "$SIZE" "$HOMENAME" 2>&1); then homefile=written
  else homefile=failed; echo "warning: HOME_FAILED: $(echo "$hout" | tail -n 1)" >&2; fi
fi

# ── Flush + power off ──────────────────────────────────────────────────────
emit flushing 0 0
sync
exec 9>&-
emit powering-off 0 0
safe=$(try_power_off)
printf '{"result":"ok","bytesWritten":%s,"sha256":"%s","imageSha256":"%s","readBackSha256":"%s","safeToRemove":%s,"timezoneFile":"%s","homeFile":"%s"}\n' "$usize" "$wsha" "$SHA" "$rsha" "$safe" "$tzfile" "$homefile"
exit 0
