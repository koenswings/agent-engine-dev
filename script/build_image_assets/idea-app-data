    swap-quarantine)
        # v24 (engine#506): updateApp's Swap copies the new bundle over instances/<id>/ and never
        # removed the files the old bundle had and the new one dropped. The Engine sends their
        # instance-relative paths on stdin (one per line); each is MOVED (rename, same disk, never
        # rm) to <root>/.idea-quarantine/<id>-swap-dropped-<UTC stamp>/<same relative path>.
        # Local Engine only; idea-peer-gate never maps a peer command here.
        need 2 $(($# - 1)) "<root> <id>"
        check_id "$3"
        SQID="$3"
        resolve_root "$2" instances
        INST=$(inst_dir "$R_DIR" "$3")
        existing_dir "$INST" "instance folder"
        containers_stopped "$3"
        take_locks "inst.$2.$3"
        INST_DEV=$($STAT -c '%d' -- "$INST" 2>/dev/null) || refuse "cannot stat $INST"
        declare -A SQ_SEEN=()
        SQ_MOVE=()
        SQ_ABSENT=()
        SQ_N=0
        sq_bad() { refuse "path $(printf '%q' "${rel:0:200}") (line $SQ_N): $*"; }
        # Pass 1: every line is checked before anything moves; one bad line refuses the whole call.
        while IFS= read -r rel || [[ -n "$rel" ]]; do
            SQ_N=$((SQ_N + 1))
            (( SQ_N <= SWAP_PATHS_MAX )) || refuse "more than $SWAP_PATHS_MAX paths on stdin"
            [[ -n "$rel" ]] || sq_bad "empty line"
            (( ${#rel} <= SWAP_PATH_MAX_LEN )) || sq_bad "longer than $SWAP_PATH_MAX_LEN characters"
            [[ "$rel" != *[[:cntrl:]]* && "$rel" != *\\* ]] || sq_bad "holds a control character or a backslash"
            [[ "$rel" != /* ]] || sq_bad "is absolute; only paths relative to the instance folder are accepted"
            [[ "$rel" != */ && "$rel" != *//* ]] || sq_bad "has a trailing '/' or '//'"
            IFS=/ read -r -a SQ_PARTS <<<"$rel"
            for part in "${SQ_PARTS[@]}"; do
                [[ "$part" != "." && "$part" != ".." ]] || sq_bad "has a '.' or '..' component"
            done
            SQ_TOP=${SQ_PARTS[0]}
            [[ "$SQ_TOP" != data ]] || sq_bad "is instance data (data/); never moved"
            [[ "$SQ_TOP" != .idea-* ]] || sq_bad "is an Engine marker (.idea-*); never moved"
            if (( ${#SQ_PARTS[@]} == 1 )); then
                [[ "$rel" != .env && "$rel" != SHA256SUMS && "$rel" != compose.yaml ]] || sq_bad "is the instance's $rel; never moved"
            fi
            [[ -z "${SQ_SEEN[$rel]:-}" ]] || sq_bad "is listed twice"
            SQ_SEEN[$rel]=1
            SQ_FULL="$INST/$rel"
            if [[ ! -e "$SQ_FULL" && ! -L "$SQ_FULL" ]]; then SQ_ABSENT+=("$rel"); continue; fi
            exact_path "$SQ_FULL" || sq_bad "is a symlink or has a symlink in its path"
            [[ -f "$SQ_FULL" && ! -L "$SQ_FULL" ]] || sq_bad "is not a regular file"
            [[ "$($STAT -c '%d' -- "$SQ_FULL" 2>/dev/null)" == "$INST_DEV" ]] || sq_bad "is on another filesystem than $INST"
            SQ_MOVE+=("$rel")
        done
        for rel in "${SQ_ABSENT[@]}"; do echo "absent=$rel"; done
        if (( ${#SQ_MOVE[@]} == 0 )); then
            echo "quarantine=none"
            journal "swap-quarantine: nothing to move in $INST (${#SQ_ABSENT[@]} path(s) already absent)"
            exit 0
        fi
        # Pass 2: the quarantine folder (root 0700; any other owner refused), then one rename per file.
        QDIR="$R_DIR/.idea-quarantine"
        root_dir "$QDIR" 0700 "quarantine folder"
        $CHMOD 0700 -- "$QDIR" || refuse "cannot set mode 0700 on $QDIR"
        [[ "$($STAT -c '%d' -- "$QDIR" 2>/dev/null)" == "$INST_DEV" ]] || refuse "$QDIR is on another filesystem than $INST"
        SQ_BASE="$QDIR/$SQID-swap-dropped-$($DATE -u +%Y%m%dT%H%M%SZ)"
        QDEST="$SQ_BASE"; SQ_K=1
        while [[ -e "$QDEST" || -L "$QDEST" ]]; do
            SQ_K=$((SQ_K + 1))
            (( SQ_K <= 9 )) || refuse "$SQ_BASE and its suffixes -2 to -9 already exist"
            QDEST="$SQ_BASE-$SQ_K"
        done
        $MKDIR -m 0700 -- "$QDEST" || refuse "cannot create $QDEST"
        echo "quarantine=$QDEST"
        SQ_DONE=0
        sq_fail() {
            refuse "$* ($SQ_DONE of ${#SQ_MOVE[@]} file(s) were already moved to $QDEST; they stay there, and updateApp's rollback restores the instance folder from its snapshot)"
        }
        for rel in "${SQ_MOVE[@]}"; do
            SQ_BASENAME=${rel##*/}
            if [[ "$rel" == */* ]]; then SQ_SUB=${rel%/*}; else SQ_SUB=""; fi
            # Work from inside the checked parent folder, so a folder swapped for a symlink after
            # pass 1 cannot redirect the move (pin_cwd refuses when the real path differs).
            if [[ -n "$SQ_SUB" ]]; then
                cd -P -- "$INST/$SQ_SUB" 2>/dev/null || sq_fail "cannot enter $INST/$SQ_SUB"
                [[ "$(pwd -P)" == "$INST/$SQ_SUB" ]] || sq_fail "$INST/$SQ_SUB changed while it was checked"
                $MKDIR -p -- "$QDEST/$SQ_SUB" || sq_fail "cannot create $QDEST/$SQ_SUB"
            else
                cd -P -- "$INST" 2>/dev/null || sq_fail "cannot enter $INST"
                [[ "$(pwd -P)" == "$INST" ]] || sq_fail "$INST changed while it was checked"
            fi
            [[ -f "./$SQ_BASENAME" && ! -L "./$SQ_BASENAME" ]] || sq_fail "$INST/$rel is no longer a regular file"
            [[ ! -e "$QDEST/$rel" && ! -L "$QDEST/$rel" ]] || sq_fail "$QDEST/$rel already exists"
            $MV -T -- "./$SQ_BASENAME" "$QDEST/$rel" || sq_fail "cannot move $INST/$rel to $QDEST/$rel"
            SQ_DONE=$((SQ_DONE + 1))
            echo "moved=$rel"
        done
        cd / || true
        $CHOWN root:root -- "$QDEST" 2>/dev/null || true
        $CHMOD 0700 -- "$QDEST" || true
        journal "swap-quarantine: $SQ_DONE file(s) the new bundle dropped: $INST -> $QDEST (${#SQ_ABSENT[@]} path(s) already absent)"
        exit 0
        ;;

