#!/bin/bash
# idea-app-data — root helper for app INSTANCE data: size, copy, send, receive,
# delete and Borg backup/restore (idea#168), and the peer side of cross-Engine
# copies with per-Pi Engine keys (protocol version 2, design-per-pi-engine-key.md)
#
# Installed as a root-owned COPY at /usr/local/sbin/idea-app-data (0755, never a
# symlink) by build-engine, next to idea-erase-disk. Allowed by ONE sudoers line
# with no argument list (11-engine-files):
#   pi ALL=(root) NOPASSWD: /usr/local/sbin/idea-app-data
# so this script validates every argument itself. The Engine (pi, under pm2)
# calls it with `sudo -n` for app instance data; locally, app masters and service
# tars are pi-owned and stay plain pi operations. A PEER Engine reaches this helper
# only through the forced command /usr/local/sbin/idea-peer-gate <peerEngineId>
# (its key's line in /etc/ssh/idea_authorized_keys/pi, written by sync-peers), which
# maps receive/delete/receive-files to the peer-* subcommands with the peer's id
# and also allows the read-only size <root> <id> verb (same helper subcommand).
#
# Why root: app containers write instance data as root (Kolibri sessions 0600),
# 999 (MariaDB, 0700 folders) and www-data (Nextcloud 0640/0770). pi cannot read
# those, so copy/move/backup/restore as pi fail or lose the owners.
#
# Usage (exact argument counts; no options are accepted from the caller):
#   idea-app-data version
#   idea-app-data size         <root> <id>
#   idea-app-data copy         <srcRoot> <srcId> <dstRoot> <dstId> [<opId>]
#                                    (v20, engine#497: with <opId>, a NON-EMPTY destination is accepted
#                                    only when instances/<dstId>.idea-op-in-flight marks that operation;
#                                    rsync then continues into it, skipping files that are already complete)
#   idea-app-data verify-copy  <srcRoot> <srcId> <dstRoot> <dstId>
#                                    (v20: read-only rsync dry run source → destination; prints
#                                    "differences=<n>" and up to 10 "diff=<item> <path>" lines; 0 = verified)
#   idea-app-data mark-in-flight  <root> <id> <opId> <engineId>
#                                    (v20: write instances/<id>.idea-op-in-flight, root 0644, NEXT TO the
#                                    instance folder, never inside it: "opId=… engineId=… created=…".
#                                    The same op again is ok; another op's marker is refused IN_FLIGHT)
#   idea-app-data clear-in-flight <root> <id> <opId>
#                                    (v20: remove that marker, only when it names <opId>; absent is ok)
#   idea-app-data send         <srcRoot> <srcId> <host> <peerEngineId> <dstRoot> <dstId> [<opId>]
#                                    (v23, engine#497 (a): with <opId> the peer receives through
#                                    peer-resume-receive, into a folder that op marked there)
#   idea-app-data verify-send  <srcRoot> <srcId> <host> <peerEngineId> <dstRoot> <dstId> <opId>
#                                    (v23: read-only rsync dry run source → peer folder; prints
#                                    "differences=<n>" and up to 10 "diff=<item> <path>" lines, like verify-copy)
#   idea-app-data receive      <dstRoot> <dstId> <rsync server args...>   (remote side of send only)
#   idea-app-data delete       <root> <id>
#   idea-app-data quarantine   <root> <id>   (v4, idea#347: rename instances/<id> to
#                                            .idea-quarantine/<id>-<UTC stamp> on the same disk,
#                                            root-owned 0700; never deletes from .idea-quarantine;
#                                            v13, idea#479: <id> may also be a legacy dotted id, see below)
#   Peer side (through idea-peer-gate; every receive refuses below the free-space floor):
#   idea-app-data peer-receive       <peerEngineId> <dstRoot> <dstId> <rsync server args...>
#                                    (a NEW instance folder; recorded in the ledger)
#   idea-app-data peer-receive-files <peerEngineId> <root> <id> <rsync server args...>
#   idea-app-data peer-delete        <peerEngineId> <root> <id>
#                                    (both only for a folder that peer's receive created
#                                    in the last 24 h, per the root-owned ledger; v23: receive-files
#                                    also into a folder under a marker of that peer)
#   idea-app-data peer-mark-in-flight   <peerEngineId> <root> <id> <opId>   (v23: marker engineId = the peer;
#                                    only for an id with NO folder yet, or the same op's own marker)
#   idea-app-data peer-clear-in-flight  <peerEngineId> <root> <id> <opId>   (v23: only that peer's marker of that op)
#   idea-app-data peer-resume-receive   <peerEngineId> <root> <id> <opId> <rsync server args...>
#                                    (v23: a new or half-written folder, only under a marker naming
#                                    that peer AND that op; no TTL; recorded in the ledger)
#   idea-app-data peer-verify-receive   <peerEngineId> <root> <id> <opId> <rsync server args...>
#                                    (v23: the receiving side of verify-send: dry run (-n) only,
#                                    under that peer's marker of that op; writes nothing)
#   idea-app-data receive-app        <root> <appId> <rsync server args...>   (as pi)
#   idea-app-data receive-service    <root> <rsync server args...>           (as pi)
#   idea-app-data size               <root> <id>   (also through idea-peer-gate; read-only)
#   idea-app-data ensure-dirs        <root>   (apps/ instances/ services/, owned by pi)
#   idea-app-data erase-slot       <slot> <stagingDir>   (TEST-ONLY: umount+mkfs+remount a loop-backed slot)
#   idea-app-data put-files        <root> <id> <stagingDir>  (local Engine: copy basenames from staging into instance as root)
#   idea-app-data kolibri-rebind   <root> <id>   (v21, engine#503: give a Kolibri copy a fresh morango id as root;
#                                    local Engine only, never through idea-peer-gate; see v21 below)
#   idea-app-data swap-quarantine  <root> <id>  < "<instance-relative path>" lines
#                                    (v24, engine#506: move files the new bundle dropped out of instances/<id>/
#                                    into .idea-quarantine/<id>-swap-dropped-<stamp>/; local Engine only; see v24)
#   Peer keys (the Engine, from its store):
#   idea-app-data sync-peers   <engineId> <storeDocId> < "<engineId> ssh-ed25519 <key> ssh-ed25519 <hostkey>" lines
#                                    (v15, engine#376: the caller's own Engine id and store document id;
#                                    owner stamp, never empties the files, quarantine copy before a change)
#   idea-app-data clear-peers  <engineId> <storeDocId>
#                                    (v15, engine#376: Ops only, by hand; the ONLY way to empty the peer
#                                    files. 11-engine-files does not allow it for the Engine)
#   idea-app-data install-usage-key <ipv4> ssh-ed25519 <base64>
#                                    (v7, idea#412: write /etc/ssh/idea_usage_keys/pi with
#                                    restrict,from="<ipv4>",command="/usr/local/sbin/idea-usage-export"
#                                    constructed here — never taken from the caller; <ipv4> must be
#                                    Tailscale 100.64/10. Appends /etc/ssh/idea_usage_keys/%u to the
#                                    existing AuthorizedKeysFile in 10-idea-peer.conf without dropping
#                                    other entries, checks sshd -t, installs idea-usage-export)
#   idea-app-data snapshot         <root> <id> [exclude…]   (v5, idea#230: copy instances/<id> to .pre-update/<id>/data, COMPLETE marker last;
#                                               v9, idea#448: excludes left out, recorded in JOURNAL and EXCLUDE)
#   idea-app-data restore-snapshot <root> <id> [exclude…]   (v9, idea#448: in place; instances/<id> is never moved. Live files that
#                                               are replaced or deleted go to .idea-quarantine/<id>-before-restore-<stamp>/;
#                                               EXCLUDE ∪ given excludes are never written, deleted or moved)
#   idea-app-data snapshots        <root>        (v5: "<id> <kb> complete|incomplete" per .pre-update snapshot)
#   idea-app-data estimate         <root> <id> [exclude…]   (read-only: "<folder kb> <volumes kb> <free kb>";
#                                               v14, idea#396: optional excludes; the folder kb is then net of the
#                                               excluded paths, and the output is still that one line)
#   idea-app-data quarantine-snapshot <root> <id>   (v14, idea#396: move .pre-update/<id> to
#                                               .idea-quarantine/<id>-pre-update-<UTC stamp> on the same disk by one
#                                               mv -T; a missing snapshot is exit 0; never deletes, never overwrites)
#   v16 (engine#401): archive names may carry a backup-mode suffix (-hook, -stop, -cold);
#        untagged names are still accepted everywhere. Builds on v15 (engine#376 peer files, unchanged).
#   v14 (idea#396): snapshot and estimate excludes must be 'data' or 'data/<rel>' after the v8
#            normalisation below (a bare name becomes data/<name>), at most 256 characters each
#            (after trimming), at most 32 after de-duplication, and an existing path (or any
#            symlink in it) must resolve inside the instance's data/ folder. NO_SPACE and the
#            estimate subtract the excluded bytes (du -sk -x; a nested path under another
#            excluded path is not counted twice). restore-snapshot keeps the v9 rules, so a
#            rollback of an older snapshot is never refused for its recorded EXCLUDE.
#   (v6, idea#406: device roots are partitions 1-9, RE_DEV ^sd[a-z][1-9]$; was [12])
#   idea-app-data borg-init    <bdev> <id>
#   idea-app-data borg-info    <bdev> <id>
#   idea-app-data borg-break-lock <bdev> <id>   (v20, engine#497: borg break-lock of that one repository, for the
#                                            Engine's own interrupted backup only (the Engine checks the owner and
#                                            that no borg runs); borg create then continues from its checkpoint)
#   idea-app-data borg-create  <bdev> <id> <archive> <srcRoot> [exclude…]   (v8, idea#443)
#   idea-app-data borg-extract <bdev> <id> <archive> <strip> <dstRoot>   (v19, engine#468: the replaced
#                                                                           instances/<id> goes to .idea-quarantine; see v19)
#   idea-app-data borg-list    <bdev> <id>                                   (v9, idea#401: archive inventory; v10, idea#450: --glob-archives '*')
#   idea-app-data borg-list    <bdev> <id> <archive>                         (v9, idea#446: member list of one archive)
#   idea-app-data borg-extract-verify <bdev> <id> <archive> <stamp>          (v9, idea#446: extract into .idea-verify/<id>-<stamp>/, never instances/<id>;
#                                                                           v12, idea#460: on success prints scratchBytes=<bytes> from du -sb -x of the dest)
#   idea-app-data borg-delete  <bdev> <id> <archive> [keepMin]               (v9, idea#401; keepMin default 3)
#   idea-app-data borg-compact <bdev> <id>                                   (v9, idea#401)
#   idea-app-data quarantine-backups <bdev>                                 (v9, idea#446: move backups/ to .idea-quarantine/backups-<UTC stamp>/; never rm)
#   idea-app-data clean-verify <bdev> <id> <stamp>                          (v17, engine#415: keep-latest. <stamp> is the copy just verified;
#                                                                           remove every OTHER complete verify copy of <id> under .idea-verify/)
#   v17 (engine#415, Koen's decision (b)): borg-extract-verify marks a complete extract with
#        .idea-verify/<id>-<stamp>.extract-ok (root, next to the tree, never inside it). clean-verify
#        removes only marked copies of that one instance, only under <bdev>/.idea-verify/, and keeps
#        <stamp>. A copy without the marker (a failed or running extract, or one made by a helper
#        older than v17) is never touched. A deliberate exception to quarantine-not-delete, limited
#        to .idea-verify scratch copies.

#   idea-app-data temp-backup-estimate <root> <id> [exclude…]                (v18, engine#469: read-only "<net kb> <free kb> <same fs 0|1>")
#   idea-app-data temp-backup-create   <root> <id> <stamp> <archive> [exclude…]  (v18: Borg repo at <system>/.idea-temp-backups/<id>/<stamp>/repo,
#                                                                           containers stopped, TEMP_BACKUP_NO_SPACE exit 3, borg check, COMPLETE last)
#   idea-app-data temp-backup-delete   <id> <stamp>                          (v18: rm -rf --one-file-system of that one folder only)
#   idea-app-data temp-backup-restore  <root> <id> <stamp>                   (v18: extract into staging, carry excluded paths over,
#                                                                           quarantine the current folder, put the restored one in place)
#   idea-app-data temp-backups                                               (v18: "<id> <stamp> <kb> complete|incomplete" lines, then "TOTAL <kb>")
#   v18 (engine#469, Koen's decision on idea#374): temporary pre-update backups on the SYSTEM disk when
#        no Backup Disk is linked. They live only under $SYSTEM_ROOT/.idea-temp-backups/ (root, 0700).
#        temp-backup-delete is the second deliberate exception to quarantine-not-delete, limited to
#        that subtree: the Engine calls it after an update passed its health gate (and for a failed,
#        never-COMPLETE create). Merged first as v18; engine#468 (borg-extract keeps the replaced folder) follows as v19 and this helper carries both.
#   v19 (engine#468; builds on v18, PR #472): borg-extract never deletes the instance folder it replaces. The previous
#        instances/<id> is moved (one rename, same disk) to .idea-quarantine/<id>-replaced-<UTC stamp>
#        (a taken stamp gets -2 … -9; nothing is ever overwritten) and stdout gets
#        replacedQuarantine=<path>. Every replaced copy is kept (quarantine, never delete;
#        cleanup via #273). When the move cannot be done the restore still succeeds, the folder
#        stays in the staging folder and stdout gets replacedKept=<path>.
#        The staging cleanup (also on a signal) never removes a .previous folder.
#   v20 (engine#497, Koen's rule: interrupted copies RESUME): the in-flight marker
#        instances/<id>.idea-op-in-flight (opId, owner engineId) is written before the first byte of a
#        local copy/move and removed only after success. copy with <opId> continues into a non-empty
#        destination only under a matching marker; without one it refuses as before. verify-copy checks
#        the result. borg-break-lock frees a repository left locked by this Engine's killed backup.
#        Every Engine skips registering or starting an instance folder that has a marker.
#   v21 (engine#503, Steve's decision): kolibri-rebind <root> <id>. The Kolibri container writes
#        data/kolibri/db.sqlite3 as root:root 0644 and the root copy keeps that owner, so the Engine's
#        old python-as-pi rebind failed with "attempt to write a readonly database" on every start of a
#        copy. Here, as root: the DB is ONLY <root>/instances/<id>/data/kolibri/db.sqlite3 (exact path,
#        no symlink anywhere, a regular file with one link); refused while a container of project <id>
#        runs; under the instance lock. A fresh 32-hex id (python3 secrets.token_hex(16)) replaces the id
#        of the current=1 row of morango_instanceidmodel (no row: nothing changes). The DB keeps its owner
#        and mode (checked after the write, restored if sqlite changed them). Nothing is deleted: a stale
#        data/kolibri/server.pid or process_cache from the source and the consumed .idea-rebind-morango
#        markers (instance root and data/kolibri/) are moved to <root>/.idea-quarantine/<id>-kolibri-*-<stamp>.
#        stdout: previousId=<id|none> and morangoId=<id|none>, or kolibriDb=absent; one quarantined=<path>
#        line per moved item. Same sudoers line (no argument list); not in the peer gate's allowlist.
#   v23 (engine#497 stage 3 (a), Koen 2026-11-17 Q1 option A: the SOURCE Engine owns the resume and
#        pushes again): cross-Engine copies and moves resume into the same folder and id on the peer.
#        The peer's gate maps four new peer verbs, always with the gate's own peer id (never one the
#        peer sends): peer-mark-in-flight (a NEW id only), peer-clear-in-flight, peer-resume-receive
#        (write into that peer's own marked folder) and peer-verify-receive (dry run only).
#        peer-receive refuses an id that has a marker. send takes an optional <opId>; verify-send is the
#        source side of the content check against the source. Nothing is ever deleted on a peer.
#   v24 (engine#506, Steve's decision): swap-quarantine <root> <id>, the instance-relative paths of the
#        files the old bundle had and the new one dropped on stdin (one per line, at most 4096, each at
#        most 1024 characters). updateApp's Swap copies the new bundle over instances/<id>/ and never
#        removed anything, so a dropped file (Nextcloud 1.8's bundled-apps/richdocuments-v8.8.3.tar.gz)
#        stayed and failed the next prepare hook. Every line is checked first and one bad line refuses
#        the whole call: relative, no '.'/'..' component, no '//', no control character or backslash,
#        not data/ (instance data), not .idea-* (Engine markers), not the top-level .env, SHA256SUMS or
#        compose.yaml, not listed twice; an existing path must be a regular file with no symlink in its
#        path, on the instance's filesystem. A missing path is reported (absent=) and skipped. Refused
#        while a container of project <id> runs; under the instance lock. Each file is MOVED (one
#        rename from inside its checked parent folder, never rm) to
#        <root>/.idea-quarantine/<id>-swap-dropped-<UTC stamp>/<same relative path> (root 0700; a
#        quarantine folder with another owner or group/other write is refused; a taken stamp gets -2 to
#        -9). stdout: absent=<path> lines, quarantine=<folder|none>, moved=<path> lines. Journaled.
#        Same sudoers line (no argument list); not in the peer gate's allowlist.
#   v25: version bump only, after #510 landed on main as v24 and #511's v23 verbs merged on top.
#        No new subcommands. CROSS_RESUME_HELPER_MIN stays 23; SWAP_QUARANTINE_HELPER_MIN stays 24.
#
# Tokens (none can start with '-' or hold '..'; only trailing borg-create
# excludes may hold '/'):
#   root     sd[a-z][1-9] → /disks/<dev>: findmnt must show source /dev/<dev>, type
#                           ext4, not the root filesystem's drive, META.yaml at its root
#            system       → /instances/<id> on the system disk
#            <slot name>  → TEST-ONLY root bridge (see below), e.g. idea-test-1
#   bdev     like root but never 'system'; the disk must hold BACKUP.yaml
#   id       ^[a-z0-9][a-z0-9-]{0,63}$
#   legacy id (quarantine only, v13, idea#479) ^[a-z0-9][a-z0-9-]*(\.[a-z0-9][a-z0-9-]*)+$, at most
#            128 characters: an older Engine's dotted id such as <id>.backup-<stamp>.
#            No '..', no leading/trailing dot, no '/'. Every other subcommand stays strict.
#   archive  ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9-]{8,16}Z(-(hook|stop|cold))?$   (backupInstance's format;
#            v16, engine#401: an optional backup-mode suffix -hook / -stop / -cold)
#   stamp    ^[0-9]{8}T[0-9]{6,15}Z$   (UTC stamp for .idea-verify/<id>-<stamp>/; no '/', no '..')
#   strip    ^[1-9]$
#   exclude  instance-relative path (v8, idea#443): no leading '/', no '..',
#            no globs; a bare name other than 'data' is treated as data/<name>.
#            Mapped to a borg path-prefix pattern under the source instance folder.
#   engine   ^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$   (a peer's Engine id)
#   app      ^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$, no '..'   (an app id, e.g. kolibri-1.0)
#   host     an IPv4 address or ^[A-Za-z0-9][A-Za-z0-9.-]{0,252}$, resolved HERE;
#            every resolved IPv4 address must be in 10/8, 172.16/12, 192.168/16 or
#            100.64/10 (LAN and Tailscale). Public, loopback or unresolvable: refused.
#
# Paths are built here from checked tokens only, and `realpath -e` must give back
# exactly the built path (no symlink anywhere in it). A copy/receive destination
# must not exist yet or be empty. copy and send refuse source data holding a
# symlink whose target (lexical or real) leaves the instance folder (idea#168 r35).
# No shell: every command is a bash array with absolute binaries and `--` before
# paths; PATH, umask and LC_ALL are fixed (sudo's env_reset strips the caller's
# environment). Every call is logged with logger to auth.notice (caller, subcommand,
# arguments, exit code, duration), refusals included. A per-instance / per-repo
# flock in a root-only folder under /run/lock keeps two runs off the same folder.
#
# TEST-ONLY root bridge (idea#168; REMOVE when the pool gets real USB disks, Stage 2):
#   The duration pool's fixture disks are folders (or loop mounts) under
#   /home/pi/idea/duration-disks/<slot>, which the Engine names by slot
#   (IDEA_DISKS_ROOT + device 'idea-test-N'). They are not /dev/sdX mounts, so the
#   checks above refuse them. Only on pool Pis, Ops may list such roots in
#   /etc/idea/app-data-roots, one absolute path per line ('#' comments allowed).
#   The file is ignored (and the reason logged) unless it is a regular file, not a
#   symlink, owned root:root, mode 0644 (so no group/other write). An entry is
#   ignored (reason logged) unless it is an absolute path without '.'/'..'
#   components or symlinks, an existing folder whose name is a slot name (not
#   sdX1/sdX2/system), and whose parent folder is owned by root and not
#   group/other writable. A root token that is not sdX1/sdX2/system resolves ONLY
#   through this file, by the entry's last path component; every use is logged as
#   "test-only root bridge". Production Pis never have this file.
#
# sync-peers takes the FULL peer set on stdin (at most 256 lines, each exactly
# '<engineId> ssh-ed25519 <base64> ssh-ed25519 <base64>', no duplicate id or key)
# and writes, each by an atomic rename of a root-owned 0644 temp file in the same
# folder, and only when the content changed:
#   /etc/ssh/idea_authorized_keys/pi   restrict,command="/usr/local/sbin/idea-peer-gate <id>" ssh-ed25519 <key> idea-peer:<id>
#   /etc/idea/peer_known_hosts         <id> ssh-ed25519 <hostkey>   (HostKeyAlias=<id>)
# The prefix is written here, never taken from the caller.
#
# v15 (engine#376): the two peer files are host-wide (one pair per Pi), but every
# Engine process used to rewrite them from ITS OWN store view, so a second Engine on
# the Pi (a separate checkout, an isolated store, an empty peer set) emptied the
# pool's keys. Now:
#   - sync-peers <engineId> <storeDocId>: the caller names its own Engine id and
#     store document id (bare id, no 'automerge:'). /etc/idea/peer-owner holds
#     '<engineId> <storeDocId>' of the Engine that owns the files: the first v15
#     sync-peers on the Pi records it; any other Engine id or store is refused
#     with PEER_OWNER_MISMATCH and nothing changes. There is no automatic takeover:
#     after a store change Ops moves /etc/idea/peer-owner aside by hand.
#   - An empty stdin is refused with PEER_SHRINK_TO_EMPTY while either file still
#     holds a peer line. A smaller, non-empty set is allowed (stale peers expire).
#   - Before every swap that changes a file, the current files are copied to
#     /etc/idea/.peer-quarantine/<UTC stamp>/ (root, 0700). Never deleted here.
#   - clear-peers <engineId> <storeDocId> (Ops, by hand; not allowed for pi in
#     11-engine-files) is the only way to empty the files: owner checked, quarantine
#     copy first, journaled.
# sshd reads the first file through /etc/ssh/sshd_config.d/10-idea-peer.conf
# (AuthorizedKeysFile), installed by build-engine.
# sync-peers must never touch /etc/ssh/idea_usage_keys (idea#412); that file is
# written only by install-usage-key, and those keys are not routed through
# idea-peer-gate.
#
# send connects as pi with the Engine's own key only and the peer's host key pinned
# by Engine id: ssh -i /home/pi/.ssh/idea_engine_ed25519 -o IdentitiesOnly=yes
# -o BatchMode=yes -o StrictHostKeyChecking=yes -o UserKnownHostsFile=/etc/idea/peer_known_hosts
# -o HostKeyAlias=<peerEngineId> -o ConnectTimeout=10 (the Engine's utils/peerSsh.ts
# builds the same list; a test keeps them equal).
#
# Exit codes: 0 ok; 2 refused (stderr "refused: <reason>"); otherwise the exit code
# of rsync/borg/du/rm. A run cancelled with TERM/INT/HUP stops its child and then
# dies of the same signal, so sudo (and the Engine) see the signal.

set -u
set -o pipefail

readonly IDEA_APP_DATA_VERSION=25

PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
umask 022
export LC_ALL=C
IFS=$' \t\n'
unset -v CDPATH GLOBIGNORE BASH_ENV ENV BORG_RSH BORG_REPO BORG_PASSPHRASE BORG_PASSCOMMAND RSYNC_RSH RSYNC_CONNECT_PROG

# ── Absolute binaries ────────────────────────────────────────────────────────
RSYNC=/usr/bin/rsync
RRSYNC=/usr/bin/rrsync
BORG=/usr/bin/borg
FINDMNT=/usr/bin/findmnt
REALPATH=/usr/bin/realpath
READLINK=/usr/bin/readlink
STAT=/usr/bin/stat
DU=/usr/bin/du
RM=/usr/bin/rm
CP=/usr/bin/cp
RMDIR=/usr/bin/rmdir
MKDIR=/usr/bin/mkdir
MKTEMP=/usr/bin/mktemp
MV=/usr/bin/mv
FIND=/usr/bin/find
FLOCK=/usr/bin/flock
LOGGER=/usr/bin/logger
GETENT=/usr/bin/getent
RUNUSER=/usr/sbin/runuser
SSH=/usr/bin/ssh
SUDO=/usr/bin/sudo
DATE=/usr/bin/date
SORT=/usr/bin/sort
DF=/usr/bin/df
CMP=/usr/bin/cmp
CHMOD=/usr/bin/chmod
CHOWN=/usr/bin/chown
INSTALL=/usr/bin/install
SSHD=/usr/sbin/sshd
