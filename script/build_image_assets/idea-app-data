                ( cd "$SDIR/volumes" && $SHA256SUM -- "$v.tar" >> SHA256SUMS ) || refuse "cannot checksum the archive of volume $v"
                bytes=$($STAT -c %s -- "$SDIR/volumes/$v.tar") || refuse "cannot size the archive of volume $v"
                ms=$(( $($DATE +%s%3N) - t0 ))
