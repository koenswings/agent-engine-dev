SUB="${1:-}"
START_MS=$($DATE +%s%3N 2>/dev/null || echo 0)
LOG_ARGS=$(printf '%q ' "$@")
LOG_ARGS=${LOG_ARGS:0:1500}
REFUSAL=""
CHILD=""
STAGING_TMP=""
BRIDGE_USED=""

# ── Logging, refusal, exit ───────────────────────────────────────────────────
journal() { $LOGGER -t idea-app-data -p auth.notice -- "$*" >/dev/null 2>&1 || true; }

log_exit() {
    local ec=$?
    local end_ms
    end_ms=$($DATE +%s%3N 2>/dev/null || echo 0)
    local msg="user=${SUDO_USER:-unknown} sub=${SUB:-none} args=${LOG_ARGS% } exit=$ec ms=$((end_ms - START_MS))"
    [[ -n "$BRIDGE_USED" ]] && msg+=" test-only-root-bridge=[$BRIDGE_USED]"
    [[ -n "$REFUSAL" ]] && msg+=" refused=$(printf '%q' "$REFUSAL")"
    journal "$msg"
}
trap log_exit EXIT

refuse() {
    REFUSAL="$*"
    echo "refused: $*" >&2
    exit 2
}

cleanup_staging() {
    if [[ -n "$STAGING_TMP" && -d "$STAGING_TMP" && ! -L "$STAGING_TMP" ]]; then
        if [[ -e "$STAGING_TMP/.previous" || -L "$STAGING_TMP/.previous" ]]; then
            # v19, engine#468: a replaced instance folder is never deleted; keep the
            # whole staging folder and say where it is
            echo "warning: kept the staging folder $STAGING_TMP: it holds the replaced instance folder .previous" >&2
            journal "staging kept: $STAGING_TMP holds .previous"
        else
            $RM -rf --one-file-system -- "$STAGING_TMP" 2>/dev/null || true
            $RMDIR -- "${STAGING_TMP%/*}" 2>/dev/null || true   # the staging folder, once empty
        fi
    fi
    STAGING_TMP=""
}

# Cancellation: stop the child, clean up, log, then die of the same signal so
# sudo re-raises it and the Engine sees a signal (not just an exit code).
on_signal() {
    local sig="$1"
    if [[ -n "$CHILD" ]]; then
        kill -"$sig" "$CHILD" 2>/dev/null || true
        wait "$CHILD" 2>/dev/null || true
        CHILD=""
    fi
    cleanup_staging
    REFUSAL=""
    SUB="${SUB} (cancelled by SIG$sig)"
    trap - EXIT
    # log the status the caller will see: 128 + signal number (143 for TERM)
    (exit $((128 + $(kill -l "$sig")))) ; log_exit
    trap - "$sig"
    kill -"$sig" $$
    exit 1
}
trap 'on_signal TERM' TERM
trap 'on_signal INT' INT
trap 'on_signal HUP' HUP

# Run a command in the background and wait, so a signal to this script is handled
# at once (bash defers traps while a foreground child runs). stdin is passed on
# explicitly (background jobs would otherwise read /dev/null; receive needs it).
exec {STDIN_FD}<&0 || STDIN_FD=0
run_child() {
    "$@" <&"${STDIN_FD:-0}" &
    CHILD=$!
    local ec=0
    wait "$CHILD" || ec=$?
    CHILD=""
    return "$ec"
}

# ── Restore: the replaced instance folder (v19, engine#468) ───────────────────
# v19, engine#468: the instance folder a restore replaced (in staging as .previous).
# Never refuses (the restore itself is done): every problem keeps the folder where it
# is and prints replacedKept=<path>.
replaced_kept() {   # replaced_kept <path> <why>
    echo "replacedKept=$1"
    echo "warning: the replaced instance folder was not quarantined ($2); it is kept at $1" >&2
    journal "replaced folder kept: $1 ($2)"
}
replaced_to_quarantine() {   # replaced_to_quarantine <R_DIR> <id> <path>
    local qdir="$1/.idea-quarantine" dest uid mode
    if [[ ! -e "$qdir" && ! -L "$qdir" ]]; then $MKDIR -m 0700 -- "$qdir" 2>/dev/null || true; fi
    if [[ -L "$qdir" || ! -d "$qdir" ]] || ! exact_path "$qdir"; then
        replaced_kept "$3" "quarantine folder $qdir is missing, a symlink or not a folder"; return 0
    fi
    read -r uid _ mode <<<"$(stat_fields "$qdir")"
    if [[ "$uid" != "$ROOT_UID" ]] || ! no_group_other_write "${mode:-777}"; then
        replaced_kept "$3" "quarantine folder $qdir must be owned by root and not group/other writable"; return 0
    fi
    $CHMOD 0700 -- "$qdir" 2>/dev/null || true
    # Every replaced copy is kept (quarantine, never delete; cleanup via #273). A
    # stamp that is already taken gets -2 … -9; when all are taken the folder stays
    # in staging. Nothing in .idea-quarantine is ever overwritten or removed here.
    local base n
    base="$qdir/$2-replaced-$($DATE -u +%Y%m%dT%H%M%SZ)"
    dest="$base"; n=1
    while [[ -e "$dest" || -L "$dest" ]]; do
        n=$((n + 1))
        if (( n > 9 )); then replaced_kept "$3" "$base and its suffixes -2 to -9 already exist"; return 0; fi
        dest="$base-$n"
    done
    if ! $MV -T -- "$3" "$dest"; then replaced_kept "$3" "cannot move it to $dest"; return 0; fi
    if [[ -e "$3" || -L "$3" ]]; then replaced_kept "$3" "it is still in staging after the move to $dest"; return 0; fi
    $CHOWN root:root -- "$dest" 2>/dev/null || true
    $CHMOD 0700 -- "$dest" 2>/dev/null || true
    journal "quarantine: replaced instance folder -> $dest"
    echo "replacedQuarantine=$dest"
}

# ── updateApp snapshots (v5, idea#230) ───────────────────────────────────────
# <R_DIR>/.pre-update/<id>/ (root 0700): JOURNAL (what started, when), data/ (the copy),
# COMPLETE (written last, by rename). A snapshot without COMPLETE is never valid or restorable;
# the next snapshot moves it to .idea-quarantine first. Nothing here ever removes data.
containers_stopped() {   # containers_stopped <id>: refuse while any container of compose project <id> exists
    [[ -x "$DOCKER" ]] || refuse "cannot check the containers of $1 ($DOCKER missing)"
    local ids
    ids=$($DOCKER ps -q --filter "label=com.docker.compose.project=$1" 2>/dev/null) || refuse "cannot list the containers of $1"
    [[ -z "$ids" ]] || refuse "RUNNING: the containers of $1 are still running; stop the instance first"
}
avail_kb() {   # avail_kb <existing folder>  (empty means /; idea#427)
    local dir="${1:-/}" a
    a=$($DF -Pk -- "$dir" 2>/dev/null | { read -r _; read -r _ _ _ a _; echo "${a:-}"; })
    [[ "$a" =~ ^[0-9]+$ ]] || refuse "cannot tell the free space of $dir"
    echo "$a"
}
quarantine_aside() {   # quarantine_aside <R_DIR> <path> <name>: move <path> to .idea-quarantine/<name>-<stamp>, echo it
    local qdir="$1/.idea-quarantine" dest
    root_dir "$qdir" 0700 "quarantine folder"
    $CHMOD 0700 -- "$qdir" || refuse "cannot set mode 0700 on $qdir"
    dest="$qdir/$3-$($DATE -u +%Y%m%dT%H%M%S%NZ)"
    [[ ! -e "$dest" && ! -L "$dest" ]] || refuse "$dest already exists"
    $MV -T -- "$2" "$dest" || refuse "cannot move $2 to $dest"
    $CHMOD 0700 -- "$dest" || true
    journal "quarantine: $2 -> $dest"
    echo "$dest"
}

# Named Docker volumes of compose project <id> (v5 call 1, Atlas conditions): exported with the
# HOST's GNU tar straight from the local-driver mountpoint under $VOLUMES_DIR, so no image is
# run or pulled at all (stricter than --pull=never); a non-local driver or an unexpected
# mountpoint is refused. Ownership, permissions, ACLs and xattrs are kept.
TAR_OPTS=(--numeric-owner --xattrs --xattrs-include='*' --acls --sparse)
VOL_NAMES=()
list_volumes() {   # list_volumes <id>: fills VOL_NAMES
    VOL_NAMES=()
    [[ -x "$DOCKER" ]] || refuse "cannot list the volumes of $1 ($DOCKER missing)"
    local out v
    out=$($DOCKER volume ls -q --filter "label=com.docker.compose.project=$1" 2>/dev/null) || refuse "cannot list the volumes of $1"
    for v in $out; do
        [[ "$v" =~ $RE_VOL ]] || refuse "volume name '$v' does not match $RE_VOL"
        VOL_NAMES+=("$v")
    done
}
volume_dir() {   # volume_dir <vol>: echo its checked local mountpoint
    local info drv mp
    info=$($DOCKER volume inspect -f '{{.Driver}} {{.Mountpoint}}' -- "$1" 2>/dev/null) || refuse "cannot inspect volume $1"
    read -r drv mp <<<"$info"
    [[ "$drv" == local ]] || refuse "volume $1 uses driver '${drv:-unknown}'; only local volumes can be snapshotted"
    [[ "$mp" == "$VOLUMES_DIR/$1/_data" ]] || refuse "volume $1 has an unexpected mountpoint '$mp'"
    [[ -d "$mp" && ! -L "$mp" && ! -L "$VOLUMES_DIR/$1" ]] || refuse "volume $1 mountpoint $mp is missing or a symlink"
    echo "$mp"
}
volume_idle() {   # volume_idle <vol>: refuse while any running container (any project) mounts it
    local ids
    ids=$($DOCKER ps -q --filter "volume=$1" 2>/dev/null) || refuse "cannot list the containers that mount volume $1"
    [[ -z "$ids" ]] || refuse "IN_USE: volume $1 is mounted by a running container (${ids//$'\n'/ }); stop it first"
}
volume_exists() { $DOCKER volume inspect -f '{{.Name}}' -- "$1" >/dev/null 2>&1; }
dir_kb() { $DU -sk -x -- "$1" | { read -r k _; echo "${k:-}"; }; }

# ── Checks ───────────────────────────────────────────────────────────────────
need() {   # need <count> <given> <usage>
    [[ "$2" -eq "$1" ]] || refuse "$SUB takes exactly $1 argument(s) ($3), got $2"
}

need_min() {   # need_min <count> <given> <usage>
    [[ "$2" -ge "$1" ]] || refuse "$SUB takes at least $1 argument(s) ($3), got $2"
}

# Normalise one x-app.backup.exclude path (idea#443). Same rules as
# src/utils/backupExclude.ts. Prints the instance-relative path or refuses.
normalize_exclude() {
    local raw="$1" p
    p=${raw#"${raw%%[![:space:]]*}"}
    p=${p%"${p##*[![:space:]]}"}
    [[ -n "$p" ]] || refuse "exclude '$raw' is empty"
    [[ "$p" != -* ]] || refuse "exclude '$raw' looks like an option"
    [[ "$p" != /* ]] || refuse "exclude '$raw' is an absolute path"
    while [[ "$p" == ./* ]]; do p=${p#./}; done
    p=${p%/}
    while [[ "$p" == */ ]]; do p=${p%/}; done
    [[ -n "$p" ]] || refuse "exclude '$raw' is empty"
    [[ "$p" != *//* ]] || refuse "exclude '$raw' contains '//'"
    [[ "$p" != *'..'* ]] || refuse "exclude '$raw' has a '.' or '..' component"
    [[ "$p" != *'/./'* && "$p" != ./* && "$p" != */. && "$p" != . ]]         || refuse "exclude '$raw' has a '.' or '..' component"
    [[ "$p" != *'*'* && "$p" != *'?'* && "$p" != *'['* && "$p" != *']'* ]]         || refuse "exclude '$raw' contains a glob"
    [[ "$p" =~ ^[A-Za-z0-9._][A-Za-z0-9._/-]*$ ]] || refuse "exclude '$raw' has unsupported characters"
    if [[ "$p" != */* && "$p" != data && "$p" != .* ]]; then
        p="data/$p"
    fi
    [[ "$p" != *'..'* ]] || refuse "exclude '$raw' has a '..' component"
    printf '%s\n' "$p"
}

# rel is already normalised; refuse if it lexically leaves $1, or if an
# existing path (or symlink) resolves outside the instance folder.
check_exclude_inside() {
    local inst="$1" rel="$2" lex real target
    inst=${inst%/}
    [[ -n "$inst" ]] || inst=/
    target="$inst/$rel"
    lex=$($REALPATH -m -s -- "$target" 2>/dev/null) || lex="$target"
    if [[ "$lex" != "$inst" && "$lex" != "$inst"/* ]]; then
        refuse "exclude '$rel' leaves the instance folder"
    fi
    if [[ -e "$target" || -L "$target" ]]; then
        real=$($REALPATH -e -- "$target" 2>/dev/null) || real=""
        if [[ -n "$real" && "$real" != "$inst" && "$real" != "$inst"/* ]]; then
            refuse "exclude '$rel' points outside the instance folder"
        fi
        # A symlink anywhere in the path: exact_path fails; realpath -e already
        # checked the final target. Also refuse if a parent component is a
        # symlink that left the instance (covered by $real). If the path exists
        # but cannot be resolved, refuse rather than pack it.
        if [[ -z "$real" ]]; then
            refuse "exclude '$rel' cannot be resolved under the instance folder"
        fi
    fi
}

# parse_excludes <instance folder> <token>...: normalise, confine and de-duplicate
# exclude tokens into EXCLUDES and their rsync options into RSYNC_EXCL (anchored at the
# transfer root, which is always the instance folder). Any bad token refuses (fail closed).
EXCLUDES=(); RSYNC_EXCL=()
parse_excludes() {
    local inst="$1" tok rel e seen
    shift
    for tok in "$@"; do
        rel=$(normalize_exclude "$tok") || exit 2
        check_exclude_inside "$inst" "$rel"
        seen=0
        for e in ${EXCLUDES[@]+"${EXCLUDES[@]}"}; do [[ "$e" == "$rel" ]] && seen=1; done
        (( seen )) && continue
        EXCLUDES+=("$rel"); RSYNC_EXCL+=("--exclude=/$rel")
    done
}

# v14 (idea#396): snapshot / estimate excludes. Same normalisation and rsync anchors as
# parse_excludes, plus: at most SNAP_EXCLUDE_MAX_LEN characters per token (after trim),
# only 'data' or 'data/<rel>', at most SNAP_EXCLUDE_MAX entries after de-duplication, and
# the path must resolve (every existing symlink followed) inside <inst>/data. Every token
# is checked before anything is locked, stopped, moved, written or sized (fail closed).
parse_snapshot_excludes() {
    local inst="$1" tok trimmed rel e seen
    shift
    for tok in "$@"; do
        trimmed=${tok#"${tok%%[![:space:]]*}"}
        trimmed=${trimmed%"${trimmed##*[![:space:]]}"}
        (( ${#trimmed} <= SNAP_EXCLUDE_MAX_LEN )) || refuse "exclude '${tok:0:64}…' is longer than $SNAP_EXCLUDE_MAX_LEN characters"
        rel=$(normalize_exclude "$tok") || exit 2
        [[ "$rel" == data || "$rel" == data/* ]] || refuse "exclude '$tok' must be data or a path under data/ (helper v14 snapshot excludes)"
        check_exclude_inside "$inst" "$rel"
        check_exclude_in_data "$inst" "$rel"
        seen=0
        for e in ${EXCLUDES[@]+"${EXCLUDES[@]}"}; do [[ "$e" == "$rel" ]] && seen=1; done
        (( seen )) && continue
        EXCLUDES+=("$rel"); RSYNC_EXCL+=("--exclude=/$rel")
        (( ${#EXCLUDES[@]} <= SNAP_EXCLUDE_MAX )) || refuse "exclude list has more than $SNAP_EXCLUDE_MAX entries"
    done
}

# check_exclude_in_data <inst> <rel>: <rel> is data or data/…; follow every existing
# symlink in the path (realpath -m) and refuse unless the result is <inst>/data or below.
# A path that exists but cannot be resolved (a loop) is refused too.
check_exclude_in_data() {
    local inst="${1%/}" rel="$2" real
    real=$($REALPATH -m -- "$inst/$rel" 2>/dev/null) || refuse "exclude '$rel' cannot be resolved under $inst/data"
    [[ "$real" == "$inst/data" || "$real" == "$inst/data/"* ]] || refuse "exclude '$rel' points outside the instance's data folder"
    if [[ -e "$inst/$rel" || -L "$inst/$rel" ]]; then
        $REALPATH -e -- "$inst/$rel" >/dev/null 2>&1 || refuse "exclude '$rel' cannot be resolved under $inst/data"
    fi
}

# excluded_kb <inst>: KB of the EXCLUDES that exist under <inst> (du -sk -x of the path
# itself; a symlink counts as the link, never its target). A path under another excluded
# path is skipped, so nested excludes are not counted twice. Sets EXCL_KB; one stderr
# trace line per counted path ("exclude <rel> <kb> KB").
EXCL_KB=0
excluded_kb() {
    local inst="${1%/}" rel e k nested
    EXCL_KB=0
    for rel in ${EXCLUDES[@]+"${EXCLUDES[@]}"}; do
        nested=0
        for e in "${EXCLUDES[@]}"; do
            [[ "$e" != "$rel" && "$rel" == "$e/"* ]] && nested=1
        done
        (( nested )) && continue
        if [[ -e "$inst/$rel" || -L "$inst/$rel" ]]; then
            k=$(dir_kb "$inst/$rel"); [[ "$k" =~ ^[0-9]+$ ]] || refuse "cannot tell the size of $inst/$rel"
        else
            k=0
        fi
        echo "exclude $rel $k KB" >&2
        EXCL_KB=$(( EXCL_KB + k ))
    done
}

check_id() { [[ "$1" =~ $RE_ID ]] || refuse "instance id '$1' does not match $RE_ID"; }
# Removal only (quarantine, v13, idea#479): a strict id, or a legacy dotted id of at most 128 characters.
check_removal_id() {
    [[ "$1" =~ $RE_ID ]] && return 0
    [[ ${#1} -le 128 && "$1" =~ $RE_LEGACY_ID ]] || refuse "instance id '$1' does not match $RE_ID or the legacy dotted form $RE_LEGACY_ID"
}
check_stamp() {
    [[ "$1" != -* ]] || refuse "stamp '$1' looks like an option"
    [[ "$1" != */* && "$1" != *..* ]] || refuse "stamp '$1' is not a UTC stamp (no path, no '..')"
    [[ "$1" =~ $RE_STAMP ]] || refuse "stamp '$1' does not match $RE_STAMP"
}

check_root_shape() {
    [[ "$1" == system || "$1" =~ $RE_DEV || "$1" =~ $RE_SLOT ]] \
        || refuse "root '$1' is not sd[a-z][1-9], system or a test-only slot name"
}

# realpath -e must give back exactly the path we built: it exists and no
# component is a symlink.
exact_path() {
    local r
    r=$($REALPATH -e -- "$1" 2>/dev/null) || return 1
    [[ "$r" == "$1" ]]
}

drive_of() {
    local d="$1"
    if [[ "$d" =~ ^(mmcblk[0-9]+|nvme[0-9]+n[0-9]+)p[0-9]+$ ]]; then echo "${BASH_REMATCH[1]}"
    elif [[ "$d" =~ ^(sd[a-z]+)[0-9]+$ ]]; then echo "${BASH_REMATCH[1]}"
    else echo "$d"
    fi
}

stat_fields() { $STAT -c '%u %g %a' -- "$1" 2>/dev/null; }

no_group_other_write() { (( (8#$1 & 8#022) == 0 )); }

# A real, mounted Engine disk: /disks/<dev> from /dev/<dev>, ext4, not on the
# root filesystem's drive, META.yaml at its root.
check_engine_disk() {
    local dev="$1" mp="$DISKS_DIR/$1" out src fst rootsrc rootdev
    exact_path "$mp" && [[ -d "$mp" ]] || refuse "$mp is not a folder (missing, or a symlink in its path)"
    src=""; fst=""
    read -r src fst _ < <($FINDMNT -n -r -o SOURCE,FSTYPE --mountpoint "$mp" 2>/dev/null)
    [[ -n "$src" ]] || refuse "$mp is not a mount point (the disk is not mounted)"
    [[ "$src" == "/dev/$dev" ]] || refuse "$mp is mounted from $src, not /dev/$dev"
    [[ "$fst" == ext4 ]] || refuse "/dev/$dev at $mp is not ext4 (got ${fst:-unknown})"
    rootsrc=""
    read -r rootsrc _ < <($FINDMNT -n -r -o SOURCE --mountpoint / 2>/dev/null)
    rootdev=${rootsrc#/dev/}
    rootdev=${rootdev%%\[*}
    [[ -n "$rootdev" ]] || refuse "cannot tell which device holds the root filesystem"
    [[ "$rootdev" != "$dev" ]] || refuse "/dev/$dev holds the root filesystem"
    [[ "$(drive_of "$rootdev")" != "$(drive_of "$dev")" ]] || refuse "/dev/$dev is on the system drive ($(drive_of "$rootdev"))"
}

# TEST-ONLY root bridge (idea#168, Stage 2 removes it). Prints the bridge root for
# a slot name, or nothing. Every reason a file or entry is ignored is logged.
bridge_ignored() {
    echo "idea-app-data: ignoring the test-only root bridge file $ROOTS_FILE: $*" >&2
    journal "test-only root bridge: ignoring $ROOTS_FILE: $*"
}
bridge_entry_ignored() {
    echo "idea-app-data: test-only root bridge: ignoring entry '$1' in $ROOTS_FILE: $2" >&2
    journal "test-only root bridge: ignoring entry $(printf '%q' "$1"): $2"
}
bridge_lookup() {
    local slot="$1" st uid gid mode line entry base parent pst puid pgid pmode found=""
    [[ -e "$ROOTS_FILE" || -L "$ROOTS_FILE" ]] || return 0
    if [[ -L "$ROOTS_FILE" ]]; then bridge_ignored "it is a symlink"; return 0; fi
    if [[ ! -f "$ROOTS_FILE" ]]; then bridge_ignored "not a regular file"; return 0; fi
    st=$(stat_fields "$ROOTS_FILE") || { bridge_ignored "cannot stat it"; return 0; }
    read -r uid gid mode <<<"$st"
    if [[ "$uid" != "$ROOT_UID" || "$gid" != "$ROOT_GID" ]]; then bridge_ignored "owner is $uid:$gid, not root:root"; return 0; fi
    if ! no_group_other_write "$mode"; then bridge_ignored "mode 0$mode lets group or others write it"; return 0; fi
    if [[ "$mode" != 644 ]]; then bridge_ignored "mode is 0$mode, not 0644"; return 0; fi
    while IFS= read -r line || [[ -n "$line" ]]; do
        entry=${line%%#*}
        entry=${entry#"${entry%%[![:space:]]*}"}
        entry=${entry%"${entry##*[![:space:]]}"}
        [[ -n "$entry" ]] || continue
        if [[ ! "$entry" =~ ^/[A-Za-z0-9._/-]+$ ]]; then bridge_entry_ignored "$entry" "not an absolute path of [A-Za-z0-9._/-]"; continue; fi
        if [[ "$entry" == *//* || "$entry" == */ ]]; then bridge_entry_ignored "$entry" "has '//' or a trailing '/'"; continue; fi
        if [[ "$entry" =~ (^|/)\.\.?(/|$) ]]; then bridge_entry_ignored "$entry" "has a '.' or '..' component"; continue; fi
        base=${entry##*/}
        parent=${entry%/*}
        [[ -n "$parent" ]] || parent=/
        if [[ ! "$base" =~ $RE_SLOT || "$base" =~ $RE_DEV || "$base" == system ]]; then
            bridge_entry_ignored "$entry" "its name '$base' is not a slot name (or is sdX1/sdX2/system)"; continue
        fi
        if ! exact_path "$entry" || [[ ! -d "$entry" ]]; then bridge_entry_ignored "$entry" "not an existing folder without symlinks in its path"; continue; fi
        pst=$(stat_fields "$parent") || { bridge_entry_ignored "$entry" "cannot stat its parent"; continue; }
        read -r puid pgid pmode <<<"$pst"
        if [[ "$puid" != "$ROOT_UID" ]]; then bridge_entry_ignored "$entry" "its parent $parent is owned by uid $puid, not root"; continue; fi
        if ! no_group_other_write "$pmode"; then bridge_entry_ignored "$entry" "its parent $parent (mode 0$pmode) is group or other writable"; continue; fi
        if [[ "$base" == "$slot" ]]; then
            if [[ -n "$found" ]]; then bridge_entry_ignored "$entry" "a second entry named '$slot'"; found="AMBIGUOUS"; continue; fi
            found="$entry"
        fi
    done < "$ROOTS_FILE"
    echo "$found"
}

# resolve_root <token> <instances|backup> → sets R_DIR (no trailing slash; '' is /; idea#237/#427)
resolve_root() {
    local tok="$1" purpose="$2" b
    R_DIR=""
    check_root_shape "$tok"
    if [[ "$tok" == system ]]; then
        [[ "$purpose" != backup ]] || refuse "a Backup Disk is never the system disk"
        R_DIR="$SYSTEM_ROOT"
        return 0
    fi
    if [[ "$tok" =~ $RE_DEV ]]; then
        check_engine_disk "$tok"
        R_DIR="$DISKS_DIR/$tok"
    else
        b=$(bridge_lookup "$tok")
        [[ "$b" != AMBIGUOUS ]] || refuse "the test-only root bridge file $ROOTS_FILE lists '$tok' more than once"
        [[ -n "$b" ]] || refuse "unknown root '$tok': not sd[a-z][1-9] or system, and not listed in a valid test-only root bridge file ($ROOTS_FILE)"
        R_DIR="$b"
        BRIDGE_USED+="${BRIDGE_USED:+ }$tok=$b"
        echo "idea-app-data: test-only root bridge: $tok -> $b" >&2
        journal "test-only root bridge: $tok -> $b (pool fixture; remove at Stage 2)"
    fi
    [[ -f "$R_DIR/META.yaml" && ! -L "$R_DIR/META.yaml" ]] || refuse "no META.yaml at the root of $R_DIR (not an Engine disk)"
    if [[ "$purpose" == backup ]]; then
        [[ -f "$R_DIR/BACKUP.yaml" && ! -L "$R_DIR/BACKUP.yaml" ]] || refuse "no BACKUP.yaml at the root of $R_DIR (not a Backup Disk)"
    fi
}

existing_dir() {   # existing_dir <path> <what>
    exact_path "$1" && [[ -d "$1" ]] || refuse "$2 $1 is not a folder (missing, or a symlink in its path)"
}

# A destination must not exist yet or be an empty real folder; created (0700, the
# copy then gives it the source's owner and mode).
prepare_dst() {   # prepare_dst <dir> [<opId>]
    local d="$1" op="${2:-}" cur
    if [[ -L "$d" ]]; then refuse "destination $d is a symlink"; fi
    if [[ -e "$d" ]]; then
        exact_path "$d" && [[ -d "$d" ]] || refuse "destination $d is not a real folder"
        local entries
        shopt -s nullglob dotglob
        entries=("$d"/*)
        shopt -u nullglob dotglob
        if (( ${#entries[@]} != 0 )); then
            # v20, engine#497: an interrupted copy of operation <opId> continues into its own
            # half-written folder, and only under that operation's in-flight marker
            [[ -n "$op" ]] || refuse "destination $d already exists and is not empty"
            cur=$(marker_opid "$d$MARKER_SUFFIX") || refuse "destination $d already exists and is not empty (no in-flight marker for operation $op)"
            [[ "$cur" == "$op" ]] || refuse "destination $d already exists and is not empty (its in-flight marker names operation $cur, not $op)"
            echo "resume: $d is not empty; continuing operation $op under its in-flight marker" >&2
            journal "resume into $d for operation $op"
        fi
    else
        $MKDIR -m 0700 -- "$d" || refuse "cannot create destination $d"
    fi
    exact_path "$d" || refuse "destination $d changed while it was prepared"
}

# copy/send: no symlink in the data may resolve outside the instance folder
# (lexically or really); the copy would share the original's data (r35).
refuse_external_links() {
    local inst="$1" l raw lex real bad=() n=0
    inside() { [[ "$1" == "$inst" || "$1" == "$inst"/* ]]; }
    while IFS= read -r -d '' l; do
        raw=$($READLINK -- "$l" 2>/dev/null) || continue
        if [[ "$raw" == /* ]]; then
            lex=$($REALPATH -m -s -- "$raw" 2>/dev/null) || lex="$raw"
        else
            lex=$($REALPATH -m -s -- "${l%/*}/$raw" 2>/dev/null) || lex="${l%/*}/$raw"
        fi
        real=$($REALPATH -e -- "$l" 2>/dev/null) || real=""
        if ! inside "$lex" || { [[ -n "$real" ]] && ! inside "$real"; }; then
            n=$((n + 1))
            (( n <= 10 )) && bad+=("'${l#"$inst"/}' -> '${real:-$lex}'")
        fi
    done < <($FIND -P "$inst" -type l -print0 2>/dev/null)
    if (( n > 0 )); then
        local more=""
        (( n > 10 )) && more=" (and $((n - 10)) more)"
        refuse "instance data links off the slot: ${bad[*]}$more"
    fi
}

check_host() {   # sets ADDR: the first resolved address; every one is checked
    local host="$1" a o1 o2 o3 o4 addrs=()
    [[ "$host" =~ $RE_HOST && "$host" != *..* ]] || refuse "host '$host' is not an IPv4 address or host name"
    while read -r a _; do
        [[ -n "$a" ]] || continue
        local dup=0 x
        for x in "${addrs[@]:-}"; do [[ "$x" == "$a" ]] && dup=1; done
        (( dup )) || addrs+=("$a")
    done < <($GETENT ahostsv4 "$host" 2>/dev/null)
    (( ${#addrs[@]} > 0 )) || refuse "host '$host' does not resolve to an IPv4 address"
    for a in "${addrs[@]}"; do
        [[ "$a" =~ $RE_IPV4 ]] || refuse "host '$host' resolves to '$a', not an IPv4 address"
        o1=$((10#${BASH_REMATCH[1]})); o2=$((10#${BASH_REMATCH[2]})); o3=$((10#${BASH_REMATCH[3]})); o4=$((10#${BASH_REMATCH[4]}))
        (( o1 <= 255 && o2 <= 255 && o3 <= 255 && o4 <= 255 )) || refuse "host '$host' resolves to '$a', not an IPv4 address"
        (( o1 != 127 )) || refuse "host '$host' resolves to loopback $a"
        if (( o1 == 10 )) || (( o1 == 172 && o2 >= 16 && o2 <= 31 )) || (( o1 == 192 && o2 == 168 )) || (( o1 == 100 && o2 >= 64 && o2 <= 127 )); then
            continue
        fi
        refuse "host '$host' resolves to $a, which is not a private LAN (10/8, 172.16/12, 192.168/16) or Tailscale (100.64/10) address"
    done
    ADDR="${addrs[0]}"
}

lock_ready() {
    if [[ ! -e "$LOCK_DIR" && ! -L "$LOCK_DIR" ]]; then $MKDIR -m 0700 -- "$LOCK_DIR" 2>/dev/null || true; fi
    [[ -d "$LOCK_DIR" && ! -L "$LOCK_DIR" ]] || refuse "lock folder $LOCK_DIR is missing or a symlink"
    local st uid gid mode
    st=$(stat_fields "$LOCK_DIR") || refuse "cannot stat $LOCK_DIR"
    read -r uid gid mode <<<"$st"
    [[ "$uid" == "$ROOT_UID" && "$mode" == 700 ]] || refuse "lock folder $LOCK_DIR must be owned by root with mode 0700 (got uid $uid, mode 0$mode)"
}
take_locks() {   # take_locks <name>... (taken in sorted order)
    lock_ready
    local name fd sorted
    sorted=$(printf '%s\n' "$@" | $SORT -u)
    while IFS= read -r name; do
        [[ -n "$name" ]] || continue
        exec {fd}>>"$LOCK_DIR/$name.lock" || refuse "cannot open lock $name"
        $FLOCK -w "$LOCK_WAIT_SECONDS" "$fd" || refuse "busy: another idea-app-data run still holds $name after ${LOCK_WAIT_SECONDS}s"
    done <<<"$sorted"
}

pin_cwd() {   # cd into a checked folder and make sure we really are there
    cd -P -- "$1" 2>/dev/null || refuse "cannot enter $1"
    [[ "$(pwd -P)" == "$1" ]] || refuse "$1 changed while it was checked"
}

borg_env() {
    export BORG_RELOCATED_REPO_ACCESS_IS_OK=yes
    export BORG_UNKNOWN_UNENCRYPTED_REPO_ACCESS_IS_OK=yes
}

inst_dir() { echo "$1/instances/$2"; }   # inst_dir <R_DIR> <id>
# v20, engine#497: the in-flight marker of instances/<id>, a sibling file (never inside the folder)
MARKER_SUFFIX=.idea-op-in-flight
marker_path() { echo "$1/instances/$2$MARKER_SUFFIX"; }   # marker_path <R_DIR> <id>
check_opid() { [[ "$1" =~ $RE_OPID ]] || refuse "operation id '$1' does not match $RE_OPID"; }
# Print the opId a marker names. Fails for anything but a regular, non-symlink, root-owned file.
marker_opid() {   # marker_opid <path>
    local m="$1" line
    [[ -f "$m" && ! -L "$m" ]] || return 1
    [[ "$($STAT -c %u -- "$m" 2>/dev/null)" == "$ROOT_UID" ]] || return 1
    while IFS= read -r line; do
        if [[ "$line" == opId=* ]]; then printf '%s\n' "${line#opId=}"; return 0; fi
    done < "$m"
    return 1
}

# v23: print the engineId a marker names (same file checks as marker_opid).
marker_engine() {   # marker_engine <path>
    local m="$1" line
    [[ -f "$m" && ! -L "$m" ]] || return 1
    [[ "$($STAT -c %u -- "$m" 2>/dev/null)" == "$ROOT_UID" ]] || return 1
    while IFS= read -r line; do
        if [[ "$line" == engineId=* ]]; then printf '%s\n' "${line#engineId=}"; return 0; fi
    done < "$m"
    return 1
}
# v23: refuse unless instances/<id> of R_DIR carries a marker of peer <peer> for op <opId>.
need_peer_marker() {   # need_peer_marker <R_DIR> <id> <peer> <opId>
    local m cur eng
    m=$(marker_path "$1" "$2")
    cur=$(marker_opid "$m") || refuse "no in-flight marker $m (a peer resumes only into a folder it marked)"
    eng=$(marker_engine "$m") || refuse "in-flight marker $m names no Engine"
    [[ "$eng" == "$3" ]] || refuse "IN_FLIGHT: $m belongs to Engine $eng, not $3"
    [[ "$cur" == "$4" ]] || refuse "IN_FLIGHT: $m marks operation $cur, not $4"
}
check_engine_id() { [[ "$1" =~ $RE_ENGINE ]] || refuse "Engine id '$1' does not match $RE_ENGINE"; }
check_app() { [[ "$1" =~ $RE_APP && "$1" != *..* ]] || refuse "app id '$1' does not match $RE_APP (or holds '..')"; }

# Sidecar Tailscale IPv4 for install-usage-key (idea#412). Options are never
# taken from the caller; only a dotted-quad in 100.64.0.0/10 is accepted.
check_usage_ipv4() {
    local ip="$1" o1 o2 o3 o4
    [[ "$ip" =~ $RE_IPV4 ]] || refuse "usage key from= address '$ip' is not an IPv4 address"
    o1=$((10#${BASH_REMATCH[1]})); o2=$((10#${BASH_REMATCH[2]})); o3=$((10#${BASH_REMATCH[3]})); o4=$((10#${BASH_REMATCH[4]}))
    (( o1 <= 255 && o2 <= 255 && o3 <= 255 && o4 <= 255 )) || refuse "usage key from= address '$ip' is not an IPv4 address"
    (( o1 == 100 && o2 >= 64 && o2 <= 127 )) || refuse "usage key from= address '$ip' is not a Tailscale IPv4 address (100.64/10)"
}

# Build the drop-in text with /etc/ssh/idea_usage_keys/%u appended to the existing
# AuthorizedKeysFile line, without dropping other entries. Prints the new file
# contents (no write). A second drop-in would replace the peer file (Debian reads
# sshd_config.d first), so this only edits the existing first line.
usage_akf_content() {
    local dropin="$PEER_SSHD_DROPIN" token="/etc/ssh/idea_usage_keys/%u"
    local st uid mode line out="" found=0
    [[ -f "$dropin" && ! -L "$dropin" ]] || refuse "sshd drop-in $dropin is missing or a symlink"
    st=$(stat_fields "$dropin") || refuse "cannot stat $dropin"
    read -r uid _ mode <<<"$st"
    [[ "$uid" == "$ROOT_UID" ]] || refuse "sshd drop-in $dropin must be owned by root (got uid $uid)"
    no_group_other_write "$mode" || refuse "sshd drop-in $dropin (mode 0$mode) must not be group or other writable"
    while IFS= read -r line || [[ -n "$line" ]]; do
        line="${line//$'\r'/}"
        if [[ "$line" =~ ^[Aa]uthorized[Kk]eys[Ff]ile[[:space:]]+ ]]; then
            found=$((found + 1))
            (( found == 1 )) || refuse "sshd drop-in $dropin has more than one AuthorizedKeysFile line; refusing to guess which one wins"
            if [[ "$line" != *"$token"* ]]; then
                line="${line%"${line##*[![:space:]]}"}"
                line="$line $token"
            fi
        fi
        out+="$line"$'\n'
    done < "$dropin"
    (( found == 1 )) || refuse "sshd drop-in $dropin has no AuthorizedKeysFile line; refusing to invent one"
    printf '%s' "$out"
}

install_usage_export() {
    if [[ -n "$USAGE_EXPORT_SRC" ]]; then
        [[ -f "$USAGE_EXPORT_SRC" && ! -L "$USAGE_EXPORT_SRC" ]] || refuse "usage export source is missing or a symlink"
        $INSTALL -o "$ROOT_UID" -g "$ROOT_GID" -m 0755 -- "$USAGE_EXPORT_SRC" "$USAGE_EXPORT" \
            || refuse "cannot install $USAGE_EXPORT"
    else
        [[ -f "$USAGE_EXPORT" && ! -L "$USAGE_EXPORT" && -x "$USAGE_EXPORT" ]] \
            || refuse "usage export $USAGE_EXPORT is not installed (run ./install-root-helpers)"
    fi
}

# The rsync server arguments of every receive: --server first, write-only, no
# character outside the safe set (rrsync -wo checks them again).
check_server_args() {
    [[ "${1:-}" == --server ]] || refuse "$SUB only runs an rsync server (first server argument must be --server)"
    local a
    for a in "$@"; do
        [[ "$a" != --sender ]] || refuse "$SUB is write-only: --sender is not allowed"
        [[ "$a" =~ $RE_SERVER_ARG ]] || refuse "unsafe rsync server argument $(printf '%q' "$a")"
    done
}

# Free-space floor: a receive is refused when the target filesystem has less than
# FREE_FLOOR_KB free (a peer cannot fill a disk to the last byte).
free_floor() {   # free_floor <existing folder>  (empty means /; idea#427)
    local dir="${1:-/}" avail
    avail=$($DF -Pk -- "$dir" 2>/dev/null | { read -r _; read -r _ _ _ a _; echo "${a:-}"; })
    [[ "$avail" =~ ^[0-9]+$ ]] || refuse "cannot tell the free space of $dir"
    (( avail >= FREE_FLOOR_KB )) || refuse "only ${avail} KB free on the filesystem of $dir; receives need at least ${FREE_FLOOR_KB} KB"
}

# A folder written as the Engine user (app masters, service tars): created 0755 if
# missing, never a symlink, owned by pi (non-recursive).
engine_user_dir() {   # engine_user_dir <path> <what>
    if [[ -L "$1" ]]; then refuse "$2 $1 is a symlink"; fi
    if [[ ! -e "$1" ]]; then $MKDIR -m 0755 -- "$1" || refuse "cannot create $2 $1"; fi
    existing_dir "$1" "$2"
    $CHOWN -h -- "$ENGINE_USER:" "$1" || refuse "cannot give $2 $1 to $ENGINE_USER"
}

# A root-owned folder that nobody else can write (peer files, ledger).
root_dir() {   # root_dir <path> <mode> <what>
    if [[ ! -e "$1" && ! -L "$1" ]]; then $MKDIR -m "$2" -- "$1" 2>/dev/null || refuse "cannot create $3 $1"; fi
    [[ -d "$1" && ! -L "$1" ]] || refuse "$3 $1 is missing or a symlink"
    local st uid gid mode
    st=$(stat_fields "$1") || refuse "cannot stat $1"
    read -r uid gid mode <<<"$st"
    [[ "$uid" == "$ROOT_UID" ]] || refuse "$3 $1 must be owned by root (got uid $uid)"
    no_group_other_write "$mode" || refuse "$3 $1 (mode 0$mode) must not be group or other writable"
}

# Write <content> to <file> by an atomic rename of a 0644 temp file in the same
# folder, only when it differs. Prints 'updated' or 'unchanged'.
swap_file() {   # swap_file <file> <content>
    local f="$1" content="$2" tmp
    if [[ -L "$f" ]]; then refuse "$f is a symlink"; fi
    tmp=$($MKTEMP -- "${f%/*}/.${f##*/}.XXXXXX") || refuse "cannot create a temp file next to $f"
    printf '%s' "$content" > "$tmp" || { $RM -f -- "$tmp"; refuse "cannot write $tmp"; }
    if [[ -f "$f" ]] && $CMP -s -- "$tmp" "$f"; then
        $RM -f -- "$tmp"
        echo unchanged
        return 0
    fi
    $CHMOD 0644 -- "$tmp" || { $RM -f -- "$tmp"; refuse "cannot chmod $tmp"; }
    $MV -f -T -- "$tmp" "$f" || { $RM -f -- "$tmp"; refuse "cannot move $tmp over $f"; }
    echo updated
}

# ── Peer files: owner stamp, shrink guard, quarantine copy (v15, engine#376) ──
check_store_doc() { [[ "$1" =~ $RE_STORE_DOC ]] || refuse "store document id '$(printf '%q' "${1:0:80}")' does not match $RE_STORE_DOC (a bare Automerge document id, no 'automerge:')"; }

# Peer lines (not empty, not a '#' comment) in <file>; 0 when it does not exist.
peer_line_count() {   # peer_line_count <file>
    local n=0 line
    [[ -f "$1" ]] || { echo 0; return 0; }
    while IFS= read -r line || [[ -n "$line" ]]; do
        [[ -n "$line" && "$line" != \#* ]] && n=$((n + 1))
    done < "$1"
    echo "$n"
}

# Sets OWNER_LINE to the recorded '<engineId> <storeDocId>' ('' when there is no
# owner file yet) and refuses PEER_OWNER_MISMATCH when it is another Engine or store.
check_peer_owner() {   # check_peer_owner <engineId> <storeDocId>
    OWNER_LINE=""
    if [[ -L "$PEER_OWNER" ]]; then refuse "peer owner file $PEER_OWNER is a symlink"; fi
    [[ -e "$PEER_OWNER" ]] || return 0
    [[ -f "$PEER_OWNER" ]] || refuse "peer owner file $PEER_OWNER is not a regular file"
    local st uid gid mode
    st=$(stat_fields "$PEER_OWNER") || refuse "cannot stat $PEER_OWNER"
    read -r uid gid mode <<<"$st"
    [[ "$uid" == "$ROOT_UID" ]] || refuse "peer owner file $PEER_OWNER must be owned by root (got uid $uid)"
    no_group_other_write "$mode" || refuse "peer owner file $PEER_OWNER (mode 0$mode) must not be group or other writable"
    local o_id o_store rest
    IFS=' ' read -r o_id o_store rest < "$PEER_OWNER" || true
    [[ "$o_id" =~ $RE_ENGINE && "$o_store" =~ $RE_STORE_DOC && -z "${rest:-}" ]] \
        || refuse "peer owner file $PEER_OWNER is not one '<engineId> <storeDocId>' line; Ops must fix it by hand (engine#376)"
    OWNER_LINE="$o_id $o_store"
    if [[ "$o_id" != "$1" || "$o_store" != "$2" ]]; then
        refuse "PEER_OWNER_MISMATCH: the peer files on this Pi belong to Engine $o_id in store $o_store ($PEER_OWNER), not to Engine $1 in store $2; nothing was changed. After a store change Ops moves $PEER_OWNER aside by hand (engine#376)"
    fi
}

# Copy the current peer files (those that exist) to a new
# $PEER_QUARANTINE_DIR/<UTC stamp>/ and echo that folder ('' when there was nothing).
quarantine_peer_files() {
    local any=0 dest
    [[ -f "$PEER_AUTH_DIR/$REMOTE_USER" ]] && any=1
    [[ -f "$PEER_KNOWN_HOSTS" ]] && any=1
    (( any )) || { echo ""; return 0; }
    root_dir "$PEER_QUARANTINE_DIR" 0700 "peer quarantine folder"
    dest="$PEER_QUARANTINE_DIR/$($DATE -u +%Y%m%dT%H%M%S%NZ)"
    $MKDIR -m 0700 -- "$dest" || refuse "cannot create $dest"
    if [[ -f "$PEER_AUTH_DIR/$REMOTE_USER" ]]; then
        $CP -p -- "$PEER_AUTH_DIR/$REMOTE_USER" "$dest/idea_authorized_keys-$REMOTE_USER" || refuse "cannot copy $PEER_AUTH_DIR/$REMOTE_USER to $dest"
    fi
    if [[ -f "$PEER_KNOWN_HOSTS" ]]; then
        $CP -p -- "$PEER_KNOWN_HOSTS" "$dest/peer_known_hosts" || refuse "cannot copy $PEER_KNOWN_HOSTS to $dest"
    fi
    echo "$dest"
}

# 0 when <file> exists and holds exactly <content>.
same_content() {   # same_content <file> <content>
    [[ -f "$1" ]] && $CMP -s -- "$1" <(printf '%s' "$2")
}

# Ledger of instance folders a peer's receive created: '<epoch> <peerEngineId>
# <root> <id>' lines in a root-only file. peer-delete and peer-receive-files need a
# matching line younger than LEDGER_TTL_SECONDS; older lines are pruned on write.
LEDGER_FILE=""
ledger_ready() {
    root_dir "$LEDGER_DIR" 0700 "ledger folder"
    local st uid mode
    read -r uid _ mode <<<"$(stat_fields "$LEDGER_DIR")"
    [[ "$mode" == 700 ]] || refuse "ledger folder $LEDGER_DIR must have mode 0700 (got 0$mode)"
    LEDGER_FILE="$LEDGER_DIR/received"
    if [[ -L "$LEDGER_FILE" ]]; then refuse "ledger $LEDGER_FILE is a symlink"; fi
    take_locks ledger
}
ledger_now() { $DATE +%s; }
ledger_has() {   # ledger_has <peer> <root> <id>
    local now t p r i
    now=$(ledger_now)
    [[ -f "$LEDGER_FILE" ]] || return 1
    while read -r t p r i _; do
        [[ "$t" =~ ^[0-9]+$ ]] || continue
        if [[ "$p" == "$1" && "$r" == "$2" && "$i" == "$3" ]] && (( now - t <= LEDGER_TTL_SECONDS )); then return 0; fi
    done < "$LEDGER_FILE"
    return 1
}
ledger_rewrite() {   # ledger_rewrite <drop root> <drop id> [<add line>]: prune old lines, drop <root> <id>, add one
    local now t p r i out=""
    now=$(ledger_now)
    if [[ -f "$LEDGER_FILE" ]]; then
        while read -r t p r i _; do
            [[ "$t" =~ ^[0-9]+$ ]] || continue
            (( now - t <= LEDGER_TTL_SECONDS )) || continue
            [[ "$r" == "$1" && "$i" == "$2" ]] && continue
            out+="$t $p $r $i"$'\n'
        done < "$LEDGER_FILE"
    fi
    [[ -n "${3:-}" ]] && out+="$3"$'\n'
    swap_file "$LEDGER_FILE" "$out" >/dev/null
    $CHMOD 0600 -- "$LEDGER_FILE" || true
}

# ── Root only ────────────────────────────────────────────────────────────────
[[ "$EUID" -eq "$ROOT_UID" ]] || refuse "must run as root (through sudo)"

case "$SUB" in
    version)
        need 0 $(($# - 1)) "none"
        echo "idea-app-data $IDEA_APP_DATA_VERSION"
        ;;

    size)
        need 2 $(($# - 1)) "<root> <id>"
        check_id "$3"
        resolve_root "$2" instances
        INST=$(inst_dir "$R_DIR" "$3")
        existing_dir "$INST" "instance folder"
        pin_cwd "$INST"
        OUT=$($DU -sk -x -- .) || exit $?
        KB=${OUT%%[[:space:]]*}
        [[ "$KB" =~ ^[0-9]+$ ]] || { echo "du gave no size: $OUT" >&2; exit 1; }
        echo "$KB"
