    borg-create)
        need_min 4 $(($# - 1)) "<bdev> <id> <archive> <srcRoot> [exclude…]"
        check_id "$3"
        [[ "$4" =~ $RE_ARCHIVE ]] || refuse "archive name '$4' does not match $RE_ARCHIVE"
        resolve_root "$2" backup; B_DIR="$R_DIR"
        resolve_root "$5" instances; S_DIR="$R_DIR"
        REPO="$B_DIR/backups/$3"
        existing_dir "$REPO" "repository folder"
        [[ -f "$REPO/config" ]] || refuse "$REPO is not a Borg repository"
        SRC=$(inst_dir "$S_DIR" "$3")
        existing_dir "$SRC" "source instance folder"
        EXCLUDES=()
        if (( $# > 5 )); then
            i=6
            while (( i <= $# )); do
                rel=$(normalize_exclude "${!i}") || exit 2
                check_exclude_inside "$SRC" "$rel"
                EXCLUDES+=("$rel")
                i=$((i + 1))
            done
        fi
        take_locks "repo.$2.$3" "inst.$5.$3"
        borg_env
        PAT=""
        cleanup_pat() { [[ -n "$PAT" && -e "$PAT" ]] && $RM -f -- "$PAT"; PAT=""; }
        if (( ${#EXCLUDES[@]} > 0 )); then
            lock_ready
            PAT=$($MKTEMP -- "$LOCK_DIR/borg-exclude.XXXXXX") || refuse "cannot create a borg exclude pattern file"
            $CHMOD 600 -- "$PAT" || { cleanup_pat; refuse "cannot chmod the borg exclude pattern file"; }
            for rel in "${EXCLUDES[@]}"; do
                printf -- '- pp:%s\n' "$SRC/$rel" >> "$PAT" || { cleanup_pat; refuse "cannot write the borg exclude pattern file"; }
            done
            EC=0
            run_child $BORG create --numeric-ids --patterns-from "$PAT" -- "$REPO::$4" "$SRC" || EC=$?
            cleanup_pat
            exit "$EC"
        fi
        run_child $BORG create --numeric-ids -- "$REPO::$4" "$SRC"
        exit $?
        ;;

    borg-extract)
        need 5 $(($# - 1)) "<bdev> <id> <archive> <strip> <dstRoot>"
        check_id "$3"
        [[ "$4" =~ $RE_ARCHIVE ]] || refuse "archive name '$4' does not match $RE_ARCHIVE"
        [[ "$5" =~ $RE_STRIP ]] || refuse "strip '$5' does not match $RE_STRIP"
        resolve_root "$2" backup; B_DIR="$R_DIR"
        resolve_root "$6" instances; D_DIR="$R_DIR"
        REPO="$B_DIR/backups/$3"
        existing_dir "$REPO" "repository folder"
        [[ -f "$REPO/config" ]] || refuse "$REPO is not a Borg repository"
        existing_dir "$D_DIR/instances" "destination instances folder"
        DST=$(inst_dir "$D_DIR" "$3")
        if [[ -L "$DST" ]]; then refuse "destination $DST is a symlink"; fi
        if [[ -e "$DST" ]]; then existing_dir "$DST" "destination"; fi
        take_locks "repo.$2.$3" "inst.$6.$3"
        # Fresh staging folder on the target disk (same filesystem, so the final
        # mv is a rename), root-only.
        STG="$D_DIR/.idea-app-data-staging"
        if [[ ! -e "$STG" && ! -L "$STG" ]]; then $MKDIR -m 0700 -- "$STG" || refuse "cannot create $STG"; fi
        existing_dir "$STG" "staging folder"
        read -r STG_UID _ STG_MODE <<<"$(stat_fields "$STG")"
        [[ "$STG_UID" == "$ROOT_UID" && "$STG_MODE" == 700 ]] || refuse "staging folder $STG must be owned by root with mode 0700"
        STAGING_TMP=$($MKTEMP -d -- "$STG/restore-$3.XXXXXX") || refuse "cannot create a staging folder in $STG"
        pin_cwd "$STAGING_TMP"
        borg_env
        EC=0
        run_child $BORG extract --numeric-ids --strip-components "$5" -- "$REPO::$4" || EC=$?
        if (( EC != 0 )); then cd / ; cleanup_staging; exit "$EC"; fi
        cd /
        shopt -s nullglob dotglob
        GOT=("$STAGING_TMP"/*)
        shopt -u nullglob dotglob
        if (( ${#GOT[@]} != 1 )) || [[ "${GOT[0]}" != "$STAGING_TMP/$3" || -L "${GOT[0]}" || ! -d "${GOT[0]}" ]]; then
            NAMES=""; for g in ${GOT[@]+"${GOT[@]}"}; do NAMES+="${g##*/} "; done
            cleanup_staging
            refuse "archive $4 did not hold exactly instances/$3 at strip $5 (got: ${NAMES:-nothing})"
        fi
        # Restore replaces the instance folder: the previous one (if any) is moved
        # aside into the staging folder, then (v19, engine#468) into .idea-quarantine
        # once the restored one is in place. Never removed here.
        if [[ -e "$DST" ]]; then
            existing_dir "$DST" "destination"
            $MV -T -- "$DST" "$STAGING_TMP/.previous" || { cleanup_staging; refuse "cannot move the previous $DST aside"; }
        fi
        $MV -T -- "$STAGING_TMP/$3" "$DST" || { EC=$?; [[ -e "$STAGING_TMP/.previous" ]] && $MV -T -- "$STAGING_TMP/.previous" "$DST"; cleanup_staging; exit "$EC"; }
        if [[ -e "$STAGING_TMP/.previous" || -L "$STAGING_TMP/.previous" ]]; then
            replaced_to_quarantine "$D_DIR" "$3" "$STAGING_TMP/.previous"
        fi
        cleanup_staging
        exit 0
        ;;

    borg-list)
        # idea#401 / helper v9: 2-arg form prints JSON of every archive
        # (borg info --json --glob-archives '*', no --last; v10, idea#450). Borg 1.x
        # `info REPO` with no archive selector prints repository info only
        # (no "archives" key), so the selector is required. idea#446: 3-arg
        # form lists members of one archive (borg list --short).
        given=$(($# - 1))
        (( given == 2 || given == 3 )) || refuse "$SUB takes 2 or 3 argument(s) (<bdev> <id> [<archive>]), got $given"
        check_id "$3"
        if (( given == 3 )); then
            [[ "$4" =~ $RE_ARCHIVE ]] || refuse "archive name '$4' does not match $RE_ARCHIVE"
        fi
        resolve_root "$2" backup
        REPO="$R_DIR/backups/$3"
        existing_dir "$REPO" "repository folder"
        [[ -f "$REPO/config" ]] || refuse "$REPO is not a Borg repository"
        borg_env
        if (( given == 2 )); then
            run_child $BORG info --json --glob-archives '*' -- "$REPO"
            exit $?
        fi
        LIST=$($BORG list --format '{name}{NL}' --sort-by timestamp -- "$REPO") || refuse "cannot list archives in $REPO"
        FOUND=0
        while IFS= read -r n; do
            [[ "$n" == "$4" ]] && FOUND=1 && break
        done <<< "$LIST"
        (( FOUND == 1 )) || refuse "archive '$4' is not in the repository"
        run_child $BORG list --short -- "$REPO::$4"
        exit $?
        ;;

    borg-delete)
        # idea#401: delete exactly the named archive. The Engine chooses; the helper
        # enforces the retention floor (default keepMin 3, never the only archive,
        # never one of the newest keepMin by borg's timestamp order).
        given=$(($# - 1))
        (( given == 3 || given == 4 )) || refuse "$SUB takes 3 or 4 argument(s) (<bdev> <id> <archive> [keepMin]), got $given"
        check_id "$3"
        [[ "$4" =~ $RE_ARCHIVE ]] || refuse "archive name '$4' does not match $RE_ARCHIVE"
        KEEP_MIN=3
        if (( given == 4 )); then
            [[ "$5" =~ ^[1-9][0-9]{0,3}$ ]] || refuse "keepMin '$5' is not a positive integer"
            KEEP_MIN=$((10#$5))
        fi
        resolve_root "$2" backup
        REPO="$R_DIR/backups/$3"
        existing_dir "$REPO" "repository folder"
        [[ -f "$REPO/config" ]] || refuse "$REPO is not a Borg repository"
        borg_env
        LIST=$($BORG list --format '{name}{NL}' --sort-by timestamp -- "$REPO") || refuse "cannot list archives in $REPO"
        NAMES=()
        while IFS= read -r n; do
            [[ -n "$n" ]] && NAMES+=("$n")
        done <<< "$LIST"
        COUNT=${#NAMES[@]}
        FOUND=0
        IDX=-1
        for i in "${!NAMES[@]}"; do
            if [[ "${NAMES[$i]}" == "$4" ]]; then FOUND=1; IDX=$i; break; fi
        done
        (( FOUND == 1 )) || refuse "archive '$4' is not in the repository"
        (( COUNT > 1 )) || refuse "refusing to delete the only archive"
        (( COUNT > KEEP_MIN )) || refuse "deleting archive '$4' would leave fewer than $KEEP_MIN archives"
        CUT=$((COUNT - KEEP_MIN))
        (( IDX < CUT )) || refuse "archive '$4' is among the newest $KEEP_MIN"
        take_locks "repo.$2.$3"
        run_child $BORG delete -- "$REPO::$4"
        exit $?
        ;;

    borg-compact)
        need 2 $(($# - 1)) "<bdev> <id>"
        check_id "$3"
        resolve_root "$2" backup
        REPO="$R_DIR/backups/$3"
        existing_dir "$REPO" "repository folder"
        [[ -f "$REPO/config" ]] || refuse "$REPO is not a Borg repository"
        take_locks "repo.$2.$3"
        borg_env
        run_child $BORG compact -- "$REPO"
        exit $?
        ;;

    borg-extract-verify)
        # idea#446 / helper v9: extract one archive into
        # <backup disk>/.idea-verify/<id>-<stamp>/ (root-owned 0700).
        # Never writes under instances/<id>, never replaces an existing tree,
        # never deletes a partial extract on failure.
        # idea#460 / helper v12: on success print scratchBytes=<n> from du -sb -x
        # of the dest so the Engine (pi) can report the size of a 0700 tree.
        need 4 $(($# - 1)) "<bdev> <id> <archive> <stamp>"
        check_id "$3"
        [[ "$4" =~ $RE_ARCHIVE ]] || refuse "archive name '$4' does not match $RE_ARCHIVE"
        check_stamp "$5"
        resolve_root "$2" backup
        REPO="$R_DIR/backups/$3"
        existing_dir "$REPO" "repository folder"
        [[ -f "$REPO/config" ]] || refuse "$REPO is not a Borg repository"
        # Destination is on the Backup Disk only — never any instances/ folder.
        VDIR="$R_DIR/.idea-verify"
        DEST="$VDIR/$3-$5"
        case "$DEST" in
            "$R_DIR/instances"|"$R_DIR/instances"/*) refuse "internal error: verify path would write under instances/" ;;
        esac
        if [[ -e "$DEST" || -L "$DEST" ]]; then refuse "verify folder $DEST already exists"; fi
        if [[ -e "$DEST.extract-ok" || -L "$DEST.extract-ok" ]]; then refuse "marker $DEST.extract-ok already exists"; fi
        root_dir "$VDIR" 0700 "verify folder"
        $CHMOD 0700 -- "$VDIR" || refuse "cannot set mode 0700 on $VDIR"
        take_locks "repo.$2.$3"
        $MKDIR -m 0700 -- "$DEST" || refuse "cannot create $DEST"
        [[ -d "$DEST" && ! -L "$DEST" ]] || refuse "verify folder $DEST is missing or a symlink"
        read -r DEST_UID _ DEST_MODE <<<"$(stat_fields "$DEST")"
        [[ "$DEST_UID" == "$ROOT_UID" && "$DEST_MODE" == 700 ]] || refuse "verify folder $DEST must be owned by root with mode 0700"
        pin_cwd "$DEST"
        borg_env
        EC=0
        # Extract the archive as stored (no --strip-components, no instances/ replace).
        run_child $BORG extract --numeric-ids -- "$REPO::$4" || EC=$?
        cd /
        # On failure leave the partial tree (never rm). On success leave it too.
        # idea#460 / helper v12: print the extract size so the Engine (running as
        # pi) can report scratchBytes. The dest is root:root 0700, so a walk as
        # pi sums nothing. A failed size measurement does not fail the extract.
        if (( EC != 0 )); then
            exit "$EC"
        fi
        # engine#415 / helper v17: mark the extract complete, next to the tree (never
        # inside it, so path checks never see it). clean-verify only removes marked
        # copies, so a failed extract (no marker) is kept for diagnosis.
        : > "$DEST.extract-ok" || refuse "cannot write the complete-extract marker $DEST.extract-ok"
        OUT=$($DU -sb -x -- "$DEST") || OUT=""
        BYTES=${OUT%%[[:space:]]*}
        if [[ "$BYTES" =~ ^[0-9]+$ ]]; then
            echo "scratchBytes=$BYTES"
        fi
        exit 0
        ;;

    clean-verify)
        # engine#415 / helper v17 (Koen's decision (b), keep-latest): <stamp> is the
        # verify copy the Engine just checked. Every OTHER copy of <id> under
        # <bdev>/.idea-verify/ that carries the complete-extract marker is removed
        # (rm -rf --one-file-system). Kept, never touched: <stamp> itself, copies
        # without the marker (failed or running extracts, kept for diagnosis; copies
        # made by a helper older than v17), symlinks, anything not owned by root, other
        # instances' copies, and everything outside .idea-verify/. Refuses the system
        # disk, a bad id or stamp, and a <stamp> copy that is missing, a symlink or not
        # a complete extract (then nothing is removed).
        need 3 $(($# - 1)) "<bdev> <id> <stamp>"
        check_id "$3"
        check_stamp "$4"
        resolve_root "$2" backup
        VDIR="$R_DIR/.idea-verify"
        if [[ -L "$VDIR" ]]; then refuse "$VDIR is a symlink"; fi
        exact_path "$VDIR" && [[ -d "$VDIR" ]] || refuse "$VDIR is not a folder (missing, or a symlink in its path)"
        read -r V_UID _ V_MODE <<<"$(stat_fields "$VDIR")"
        [[ "$V_UID" == "$ROOT_UID" ]] && no_group_other_write "$V_MODE" \
            || refuse "$VDIR must be owned by root and not group/other writable"
        KEEP="$VDIR/$3-$4"
        if [[ -L "$KEEP" ]]; then refuse "verify folder $KEEP is a symlink"; fi
        exact_path "$KEEP" && [[ -d "$KEEP" ]] || refuse "verify folder $KEEP is missing"
        [[ -f "$KEEP.extract-ok" && ! -L "$KEEP.extract-ok" ]] \
            || refuse "verify folder $KEEP has no complete-extract marker (a failed extract, or made by a helper older than v17); nothing removed"
        take_locks "repo.$2.$3"
        CV_FAIL=0
        shopt -s nullglob dotglob
        for CAND in "$VDIR/$3-"*; do
            CNAME=${CAND##*/}
            CSTAMP=${CNAME#"$3-"}
            # another instance whose id starts with '<id>-', or a marker file: not ours
            [[ "$CSTAMP" =~ $RE_STAMP ]] || continue
            [[ "$CAND" != "$KEEP" ]] || continue
            if [[ -L "$CAND" ]]; then echo "skipped $CAND: a symlink (never followed)" >&2; continue; fi
            [[ -d "$CAND" ]] || continue
            if [[ ! -f "$CAND.extract-ok" || -L "$CAND.extract-ok" ]]; then
                echo "kept $CAND: no complete-extract marker (failed extract, kept for diagnosis)" >&2
                continue
            fi
            exact_path "$CAND" || { echo "skipped $CAND: does not resolve to itself" >&2; continue; }
            read -r C_UID _ _ <<<"$(stat_fields "$CAND")"
            [[ "$C_UID" == "$ROOT_UID" ]] || { echo "skipped $CAND: not owned by root" >&2; continue; }
            if $RM -rf --one-file-system -- "$CAND"; then
                $RM -f -- "$CAND.extract-ok" || true
                journal "clean-verify: removed $CAND (kept $KEEP)"
                echo "removed $CAND"
            else
                echo "could not remove $CAND (left with its marker; the next clean-verify retries)" >&2
                CV_FAIL=1
            fi
        done
        shopt -u nullglob dotglob
        echo "kept $KEEP"
        exit "$CV_FAIL"
        ;;

    temp-backup-estimate)
        # v18 (engine#469): read-only (no lock, nothing stopped or written). Prints
        # "<net kb> <free kb> <same filesystem 0|1>": the instance folder net of the given
        # x-app.backup.exclude paths (the borg-create rules), the free space of the system
        # disk, and 1 when <root> is on that same filesystem (the snapshot then lands there too).
        need_min 2 $(($# - 1)) "<root> <id> [exclude…]"
        check_id "$3"
        resolve_root "$2" instances
        INST=$(inst_dir "$R_DIR" "$3")
        [[ ! -L "$INST" ]] || refuse "$INST is a symlink"
        existing_dir "$INST" "instance folder"
        parse_excludes "$INST" "${@:4}"
        INST_KB=$(dir_kb "$INST"); [[ "$INST_KB" =~ ^[0-9]+$ ]] || refuse "cannot tell the size of $INST"
        excluded_kb "$INST"
        NET_KB=$(( INST_KB > EXCL_KB ? INST_KB - EXCL_KB : 0 ))
        SYS_DIR="${SYSTEM_ROOT:-/}"
        FREE_KB=$(avail_kb "$SYS_DIR")
        D1=$($STAT -c %d -- "${R_DIR:-/}") || refuse "cannot stat ${R_DIR:-/}"
        D2=$($STAT -c %d -- "$SYS_DIR") || refuse "cannot stat $SYS_DIR"
        if [[ "$D1" == "$D2" ]]; then SAME=1; else SAME=0; fi
        echo "$NET_KB $FREE_KB $SAME"
        exit 0
        ;;

    temp-backup-create)
        # v18 (engine#469, Koen's decision on idea#374): the temporary pre-update backup when
        # no Backup Disk is linked. A Borg repository (encryption none) of instances/<id> at
        # <system disk>/.idea-temp-backups/<id>/<stamp>/repo, archive <archive>, with the
        # given x-app.backup.exclude paths left out (borg-create rules). Only while the
        # instance's containers are stopped. Refuses TEMP_BACKUP_NO_SPACE (exit 3) before
        # anything is written when the system disk has less than the net size plus the
        # snapshot margin free. `borg check` must pass before COMPLETE is written (by
        # rename, last). Prints "<folder> <kb>". A failed run leaves its folder without
        # COMPLETE; the Engine removes it with temp-backup-delete.
        need_min 4 $(($# - 1)) "<root> <id> <stamp> <archive> [exclude…]"
        check_id "$3"
        check_stamp "$4"
        [[ "$5" =~ $RE_ARCHIVE ]] || refuse "archive name '$5' does not match $RE_ARCHIVE"
        resolve_root "$2" instances
        SRC=$(inst_dir "$R_DIR" "$3")
        [[ ! -L "$SRC" ]] || refuse "$SRC is a symlink"
        existing_dir "$SRC" "source instance folder"
        parse_excludes "$SRC" "${@:6}"
        take_locks "tmpbk.$3" "inst.$2.$3"
        containers_stopped "$3"
        INST_KB=$(dir_kb "$SRC"); [[ "$INST_KB" =~ ^[0-9]+$ ]] || refuse "cannot tell the size of $SRC"
        excluded_kb "$SRC"
        NET_KB=$(( INST_KB > EXCL_KB ? INST_KB - EXCL_KB : 0 ))
        MARGIN_KB=$(( NET_KB * SNAPSHOT_MARGIN_PCT / 100 ))
        (( MARGIN_KB >= FREE_FLOOR_KB )) || MARGIN_KB=$FREE_FLOOR_KB
        FREE_KB=$(avail_kb "${SYSTEM_ROOT:-/}")
        if (( FREE_KB < NET_KB + MARGIN_KB )); then
            REFUSAL="TEMP_BACKUP_NO_SPACE"
            echo "TEMP_BACKUP_NO_SPACE: the temporary backup needs $(( (NET_KB + MARGIN_KB) * 1024 )) bytes ($NET_KB KB folder + $MARGIN_KB KB margin; $EXCL_KB KB excluded), free $(( FREE_KB * 1024 )) bytes on the system disk" >&2
            exit $EXIT_NO_SPACE
        fi
        TB_BASE="$SYSTEM_ROOT/$TEMP_BACKUPS_NAME"
        root_dir "$TB_BASE" 0700 "temporary backup folder"
        $CHMOD 0700 -- "$TB_BASE" || refuse "cannot set mode 0700 on $TB_BASE"
        exact_path "$TB_BASE" || refuse "$TB_BASE does not resolve to itself"
        TB_ID="$TB_BASE/$3"
        root_dir "$TB_ID" 0700 "temporary backup folder"
        $CHMOD 0700 -- "$TB_ID" || refuse "cannot set mode 0700 on $TB_ID"
        exact_path "$TB_ID" || refuse "$TB_ID does not resolve to itself"
        T="$TB_ID/$4"
        [[ ! -e "$T" && ! -L "$T" ]] || refuse "$T already exists"
        $MKDIR -m 0700 -- "$T" || refuse "cannot create $T"
        exact_path "$T" || refuse "$T does not resolve to itself"
        printf '%s\n' "$SRC" > "$T/SOURCE" || refuse "cannot write $T/SOURCE"
        printf '%s\n' "$5" > "$T/ARCHIVE" || refuse "cannot write $T/ARCHIVE"
        : > "$T/EXCLUDE" || refuse "cannot write $T/EXCLUDE"
        for rel in ${EXCLUDES[@]+"${EXCLUDES[@]}"}; do
            printf '%s\n' "$rel" >> "$T/EXCLUDE" || refuse "cannot write $T/EXCLUDE"
        done
        journal "temp-backup-create: $SRC -> $T started (net $NET_KB KB, free $FREE_KB KB, ${#EXCLUDES[@]} excludes)"
        REPO="$T/repo"
        borg_env
        run_child $BORG init --encryption=none -- "$REPO" || exit $?
        PAT=""
        cleanup_pat() { [[ -n "$PAT" && -e "$PAT" ]] && $RM -f -- "$PAT"; PAT=""; }
        EC=0
        if (( ${#EXCLUDES[@]} > 0 )); then
            lock_ready
            PAT=$($MKTEMP -- "$LOCK_DIR/borg-exclude.XXXXXX") || refuse "cannot create a borg exclude pattern file"
            $CHMOD 600 -- "$PAT" || { cleanup_pat; refuse "cannot chmod the borg exclude pattern file"; }
            for rel in "${EXCLUDES[@]}"; do
                printf -- '- pp:%s\n' "$SRC/$rel" >> "$PAT" || { cleanup_pat; refuse "cannot write the borg exclude pattern file"; }
            done
            run_child $BORG create --numeric-ids --patterns-from "$PAT" -- "$REPO::$5" "$SRC" || EC=$?
            cleanup_pat
        else
            run_child $BORG create --numeric-ids -- "$REPO::$5" "$SRC" || EC=$?
        fi
        (( EC == 0 )) || exit "$EC"
        run_child $BORG check -- "$REPO" || exit $?
        GOT_KB=$(dir_kb "$T"); GOT_KB=${GOT_KB:-0}
        echo "complete $($DATE -u +%Y-%m-%dT%H:%M:%SZ) kb=$GOT_KB archive=$5" > "$T/.COMPLETE.tmp" || refuse "cannot write the COMPLETE marker"
        $MV -T -- "$T/.COMPLETE.tmp" "$T/COMPLETE" || refuse "cannot write the COMPLETE marker"
        journal "temp-backup-create: $T complete ($GOT_KB KB)"
        echo "$T $GOT_KB"
        exit 0
        ;;

    temp-backup-delete)
        # v18 (engine#469): Koen's explicit exception to quarantine-not-delete, limited to
        # the temporary pre-update backups: rm -rf --one-file-system of
        # <system disk>/.idea-temp-backups/<id>/<stamp> only. The path is built from checked
        # tokens; the base, the instance folder and the backup must be real folders (no
        # symlink anywhere, realpath gives the path back) owned by root and not group/other
        # writable. A missing backup is exit 0 (a retry). The empty <id> folder is removed too.
        need 2 $(($# - 1)) "<id> <stamp>"
        check_id "$2"
        check_stamp "$3"
        TB_BASE="$SYSTEM_ROOT/$TEMP_BACKUPS_NAME"
        TB_ID="$TB_BASE/$2"
        T="$TB_ID/$3"
        for p in "$TB_BASE" "$TB_ID" "$T"; do [[ ! -L "$p" ]] || refuse "$p is a symlink"; done
        if [[ ! -e "$T" ]]; then
            echo "ok: $T does not exist; nothing to delete" >&2
            exit 0
        fi
        for p in "$TB_BASE" "$TB_ID" "$T"; do
            exact_path "$p" && [[ -d "$p" ]] || refuse "$p is not a folder (missing, or a symlink in its path)"
            read -r P_UID _ P_MODE <<<"$(stat_fields "$p")"
            [[ "$P_UID" == "$ROOT_UID" ]] && no_group_other_write "$P_MODE" \
                || refuse "$p must be owned by root and not group/other writable"
        done
        case "$T" in
            "$TB_BASE"/"$2"/"$3") ;;
            *) refuse "internal error: $T is not under $TB_BASE" ;;
        esac
        take_locks "tmpbk.$2"
        if ! $RM -rf --one-file-system -- "$T"; then
            echo "could not remove $T completely (left in place; the next temp-backup-delete retries)" >&2
            exit 1
        fi
        $RMDIR -- "$TB_ID" 2>/dev/null || true
        journal "temp-backup-delete: removed $T"
        echo "removed $T"
        exit 0
        ;;

    temp-backup-restore)
        # v18 (engine#469): restore instances/<id> on <root> from a COMPLETE temporary backup
        # (failure path, or Ops by hand). Only while the containers are stopped. The archive
        # is extracted into a root-only staging folder on <root>; the paths the backup left
        # out (its EXCLUDE, e.g. data/tailscale) are moved over from the current folder so
        # their inodes survive; then the current folder goes to
        # <root>/.idea-quarantine/<id>-before-temp-restore-<stamp> (never rm) and the restored
        # one takes its place. The temporary backup itself is kept. Last line: the
        # quarantined folder, or 'none'.
        need 3 $(($# - 1)) "<root> <id> <stamp>"
        check_id "$3"
        check_stamp "$4"
        resolve_root "$2" instances; D_DIR="$R_DIR"
        TB_BASE="$SYSTEM_ROOT/$TEMP_BACKUPS_NAME"
        T="$TB_BASE/$3/$4"
        REPO="$T/repo"
        for p in "$TB_BASE" "$TB_BASE/$3" "$T" "$REPO"; do
            [[ ! -L "$p" ]] || refuse "$p is a symlink"
            exact_path "$p" && [[ -d "$p" ]] || refuse "$p is not a folder (missing, or a symlink in its path)"
        done
        [[ -f "$T/COMPLETE" && ! -L "$T/COMPLETE" ]] || refuse "the temporary backup $T has no COMPLETE marker; it is never restored"
        [[ -f "$REPO/config" ]] || refuse "$REPO is not a Borg repository"
        for f in ARCHIVE SOURCE EXCLUDE; do
            [[ -f "$T/$f" && ! -L "$T/$f" ]] || refuse "$T/$f is missing or not a regular file"
        done
        IFS= read -r ARCH < "$T/ARCHIVE" || true
        [[ "${ARCH:-}" =~ $RE_ARCHIVE ]] || refuse "$T/ARCHIVE does not hold an archive name"
        IFS= read -r SRC_REC < "$T/SOURCE" || true
        # The system disk's SYSTEM_ROOT is '' (idea#237), so a kit's SOURCE is /instances/<id>
        # with no component before 'instances' (engine#469 Pi proof step 6); a disk's is
        # /disks/<dev>/instances/<id>. Both are allowed; '..', '//' and other ids are not.
        [[ ( "${SRC_REC:-}" == /instances/"$3" || "${SRC_REC:-}" == /*/instances/"$3" ) && "$SRC_REC" != *..* && "$SRC_REC" != *//* ]] \
            || refuse "$T/SOURCE does not hold an instances/$3 path"
        REL=${SRC_REC#/}
        IFS=/ read -r -a PARTS <<<"$REL"
        STRIP=$(( ${#PARTS[@]} - 1 ))
        (( STRIP >= 1 && STRIP <= 32 )) || refuse "cannot strip $SRC_REC ($STRIP components)"
        REC=()
        while IFS= read -r line || [[ -n "$line" ]]; do
            [[ -n "$line" ]] && REC+=("$line")
        done < "$T/EXCLUDE"
        existing_dir "$D_DIR/instances" "destination instances folder"
        DST=$(inst_dir "$D_DIR" "$3")
        [[ ! -L "$DST" ]] || refuse "destination $DST is a symlink"
        if [[ -e "$DST" ]]; then existing_dir "$DST" "destination"; fi
        EXCLUDES=(); RSYNC_EXCL=()
        if [[ -e "$DST" ]]; then parse_excludes "$DST" ${REC[@]+"${REC[@]}"}; fi
        take_locks "tmpbk.$3" "inst.$2.$3"
        containers_stopped "$3"
        STG="$D_DIR/.idea-app-data-staging"
        if [[ ! -e "$STG" && ! -L "$STG" ]]; then $MKDIR -m 0700 -- "$STG" || refuse "cannot create $STG"; fi
        existing_dir "$STG" "staging folder"
        read -r STG_UID _ STG_MODE <<<"$(stat_fields "$STG")"
        [[ "$STG_UID" == "$ROOT_UID" && "$STG_MODE" == 700 ]] || refuse "staging folder $STG must be owned by root with mode 0700"
        STAGING_TMP=$($MKTEMP -d -- "$STG/temp-restore-$3.XXXXXX") || refuse "cannot create a staging folder in $STG"
        pin_cwd "$STAGING_TMP"
        borg_env
        EC=0
        run_child $BORG extract --numeric-ids --strip-components "$STRIP" -- "$REPO::$ARCH" || EC=$?
        cd /
        if (( EC != 0 )); then cleanup_staging; exit "$EC"; fi
        shopt -s nullglob dotglob
        GOT=("$STAGING_TMP"/*)
        shopt -u nullglob dotglob
        if (( ${#GOT[@]} != 1 )) || [[ "${GOT[0]}" != "$STAGING_TMP/$3" || -L "${GOT[0]}" || ! -d "${GOT[0]}" ]]; then
            TB_NAMES=""; for g in ${GOT[@]+"${GOT[@]}"}; do TB_NAMES+="${g##*/} "; done
            cleanup_staging
            refuse "archive $ARCH did not hold exactly instances/$3 at strip $STRIP (got: ${TB_NAMES:-nothing})"
        fi
        NEW="$STAGING_TMP/$3"
        for rel in ${EXCLUDES[@]+"${EXCLUDES[@]}"}; do
            if [[ ( -e "$DST/$rel" || -L "$DST/$rel" ) && ! -e "$NEW/$rel" && ! -L "$NEW/$rel" ]]; then
                if [[ "$rel" == */* ]]; then
                    $MKDIR -p -m 0700 -- "$NEW/${rel%/*}" || { cleanup_staging; refuse "cannot prepare $NEW/${rel%/*}"; }
                fi
                $MV -T -- "$DST/$rel" "$NEW/$rel" || { cleanup_staging; refuse "cannot carry over the excluded path $rel"; }
                echo "kept excluded path $rel" >&2
            fi
        done
        ASIDE=none
        if [[ -e "$DST" ]]; then
            ASIDE=$(quarantine_aside "$D_DIR" "$DST" "$3-before-temp-restore") || { cleanup_staging; exit 2; }
        fi
        if ! $MV -T -- "$NEW" "$DST"; then
            EC=1
            [[ "$ASIDE" != none ]] && $MV -T -- "$ASIDE" "$DST"
            cleanup_staging
            exit "$EC"
        fi
        cleanup_staging
        journal "temp-backup-restore: $DST restored from $T ($ARCH); replaced folder: $ASIDE"
        echo "restored $DST from $T" >&2
        echo "$ASIDE"
        exit 0
        ;;

    temp-backups)
        # v18 (engine#469): read-only list "<id> <stamp> <kb> complete|incomplete" of the
        # temporary pre-update backups on the system disk, then "TOTAL <kb>".
        need 0 $(($# - 1)) ""
        TB_BASE="$SYSTEM_ROOT/$TEMP_BACKUPS_NAME"
        [[ ! -L "$TB_BASE" ]] || refuse "$TB_BASE is a symlink"
        if [[ ! -d "$TB_BASE" ]]; then echo "TOTAL 0"; exit 0; fi
        for d in "$TB_BASE"/*/*/; do
            [[ -d "$d" ]] || continue
            t=${d%/}; [[ ! -L "$t" && ! -L "${t%/*}" ]] || continue
            stamp=${t##*/}; id=${t%/*}; id=${id##*/}
            [[ "$id" =~ $RE_ID && "$stamp" =~ $RE_STAMP ]] || continue
            kb=$(dir_kb "$t"); kb=${kb:-0}
            if [[ -f "$t/COMPLETE" && ! -L "$t/COMPLETE" ]]; then echo "$id $stamp $kb complete"; else echo "$id $stamp $kb incomplete"; fi
        done
        echo "TOTAL $(dir_kb "$TB_BASE")"
        exit 0
        ;;

    quarantine-backups)
        # idea#446 / helper v9: move <disk>/backups/ to
        # <disk>/.idea-quarantine/backups-<UTC stamp>/ (mv only, never rm).
        need 1 $(($# - 1)) "<bdev>"
        resolve_root "$2" backup
        BACKUPS="$R_DIR/backups"
        existing_dir "$BACKUPS" "backups folder"
        if [[ -e "$BACKUPS/.backup-in-progress" || -L "$BACKUPS/.backup-in-progress" ]]; then
            refuse "a .backup-in-progress lock exists at $BACKUPS/.backup-in-progress"
        fi
        shopt -s nullglob
        for instdir in "$BACKUPS"/*; do
            if [[ -e "$instdir/.backup-in-progress" || -L "$instdir/.backup-in-progress" ]]; then
                shopt -u nullglob
                refuse "a .backup-in-progress lock exists at $instdir/.backup-in-progress"
            fi
        done
        shopt -u nullglob
        QDIR="$R_DIR/.idea-quarantine"
        root_dir "$QDIR" 0700 "quarantine folder"
        $CHMOD 0700 -- "$QDIR" || refuse "cannot set mode 0700 on $QDIR"
        QDEST="$QDIR/backups-$($DATE -u +%Y%m%dT%H%M%S%NZ)"
        [[ ! -e "$QDEST" && ! -L "$QDEST" ]] || refuse "$QDEST already exists"
        take_locks "backups.$2"
        $MV -T -- "$BACKUPS" "$QDEST" || refuse "cannot move $BACKUPS to $QDEST"
        $CHMOD 0700 -- "$QDEST" || true
        journal "quarantine-backups: $BACKUPS -> $QDEST"
        echo "$QDEST"
        exit 0
        ;;

    erase-slot)
        # TEST-ONLY: erase a loop-backed duration slot to an empty IDEA disk (Path A /
        # idea#168 confirm_erase). Production USB erase stays on idea-erase-disk.
        # umount + mkfs.ext4 + remount; never wipefs/sfdisk (the slot is a filesystem
        # image, not a partitioned whole disk).
        need 2 $(($# - 1)) "<slot> <stagingDir>"
        SLOT_TOKEN="$2"
        STAGING="$3"
        check_root_shape "$SLOT_TOKEN"
        [[ "$SLOT_TOKEN" =~ $RE_DEV || "$SLOT_TOKEN" == system ]] \
            && refuse "erase-slot is only for test slot names (got '$SLOT_TOKEN')"
        b=$(bridge_lookup "$SLOT_TOKEN")
        [[ "$b" != AMBIGUOUS ]] || refuse "the test-only root bridge file $ROOTS_FILE lists '$SLOT_TOKEN' more than once"
        [[ -n "$b" && "$b" != AMBIGUOUS ]] || refuse "unknown root '$SLOT_TOKEN' (not in the test-only root bridge)"
        SLOT_DIR="$b"
        BRIDGE_USED="$SLOT_TOKEN=$SLOT_DIR"
        echo "idea-app-data: test-only root bridge: $SLOT_TOKEN -> $SLOT_DIR" >&2
        journal "test-only root bridge: $SLOT_TOKEN -> $SLOT_DIR"

        # Staging: same rules as idea-erase-disk (META.yaml only, under erase-staging)
        [[ "$STAGING" =~ ^/home/pi/\.local/state/idea-engine/erase-staging/[A-Za-z0-9_-]+$ ]] \
            || refuse "stagingDir must be under /home/pi/.local/state/idea-engine/erase-staging/<id>"
        check="$STAGING"
        while [[ "$check" != "/" && "$check" != "" ]]; do
            if [[ -L "$check" ]]; then
                refuse "staging path contains a symlink ($check)"
            fi
            check=$(dirname "$check")
        done
        [[ -d "$STAGING" ]] || refuse "stagingDir is not a directory"
        owner=$($STAT -c '%U' "$STAGING" 2>/dev/null || true)
        [[ "$owner" == "pi" || "$owner" == "$ENGINE_USER" ]] \
            || refuse "stagingDir must be owned by pi (got ${owner:-unknown})"
        shopt -s nullglob dotglob
        entries=("$STAGING"/*)
        shopt -u nullglob dotglob
        for e in "${entries[@]:-}"; do
            base=$(basename "$e")
            [[ "$base" == "META.yaml" ]] || refuse "stagingDir may contain only META.yaml (found $base)"
        done
        [[ -f "$STAGING/META.yaml" ]] || refuse "stagingDir is missing META.yaml"

        echo "STEP:checking"
        src=""; fst=""
        read -r src fst _ < <($FINDMNT -n -r -o SOURCE,FSTYPE --mountpoint "$SLOT_DIR" 2>/dev/null) || true
        [[ -n "$src" ]] || refuse "$SLOT_DIR is not a mount point (need a loop-backed fixture)"
        [[ "$fst" == ext4 ]] || refuse "$SLOT_DIR is not ext4 (got ${fst:-unknown})"
        [[ "$src" =~ ^/dev/loop[0-9]+$ ]] \
            || refuse "$SLOT_DIR is mounted from $src, not a loop device (erase-slot is loop-only)"

        # Never touch the system root's device
        rootsrc=""
        read -r rootsrc _ < <($FINDMNT -n -r -o SOURCE --mountpoint / 2>/dev/null) || true
        rootdev=${rootsrc#/dev/}
        rootdev=${rootdev%%\[*}
        [[ -n "$rootdev" ]] || refuse "cannot tell which device holds the root filesystem"
        [[ "$src" != "/dev/$rootdev" && "$src" != "$rootsrc" ]] \
            || refuse "$src holds the root filesystem"

        backing=""
        backing=$($LOSETUP -n -O BACK-FILE -- "$src" 2>/dev/null | head -1 | tr -d '[:space:]' || true)

        echo "STEP:unmounting"
        if ! $UMOUNT -- "$SLOT_DIR"; then
            refuse "could not unmount $SLOT_DIR"
        fi

        wipe_target="$src"
        if [[ ! -b "$wipe_target" ]]; then
            [[ -n "$backing" && -e "$backing" && ! -L "$backing" ]] \
                || refuse "loop device $src is gone after umount and no backing file was found"
            wipe_target="$backing"
        fi

        echo "STEP:creating filesystem"
        $MKFS -F -L "IDEA Disk" -E root_owner=1000:1000 -d "$STAGING" "$wipe_target" >/dev/null \
            || refuse "mkfs.ext4 failed on $wipe_target"

        echo "STEP:mounting"
        if [[ -b "$src" ]]; then
            $MOUNT -t ext4 -- "$src" "$SLOT_DIR" || refuse "could not remount $src on $SLOT_DIR"
        elif [[ -n "$backing" && -e "$backing" ]]; then
            $MOUNT -t ext4 -o loop -- "$backing" "$SLOT_DIR" || refuse "could not remount loop $backing on $SLOT_DIR"
        else
            $MOUNT -- "$SLOT_DIR" || refuse "could not remount $SLOT_DIR from fstab"
        fi
        [[ -f "$SLOT_DIR/META.yaml" ]] || refuse "META.yaml missing after erase-slot remount"
        echo "ok: erased slot $SLOT_TOKEN as empty IDEA disk"
        ;;

    "")
        refuse "no subcommand (version, size, copy, send, receive, delete, quarantine, snapshot, restore-snapshot, snapshots, estimate, quarantine-snapshot, borg-init, borg-info, borg-create, borg-extract, borg-list, borg-extract-verify, borg-delete, borg-compact, quarantine-backups, clean-verify, temp-backup-estimate, temp-backup-create, temp-backup-delete, temp-backup-restore, temp-backups, peer-receive, peer-receive-files, peer-delete, peer-mark-in-flight, peer-clear-in-flight, peer-resume-receive, peer-verify-receive, verify-send, receive-app, receive-service, ensure-dirs, erase-slot, put-files, kolibri-rebind, swap-quarantine, sync-peers, clear-peers, install-usage-key)"
        ;;
    *)
        refuse "unknown subcommand '$(printf '%q' "$SUB")'"
        ;;
esac
exit 0
