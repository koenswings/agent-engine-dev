            [[ -f "$SDIR/EXCLUDE" && ! -L "$SDIR/EXCLUDE" ]] || refuse "$SDIR/EXCLUDE is not a regular file"
            while IFS= read -r line || [[ -n "$line" ]]; do
                [[ -n "$line" ]] && REC+=("$line")
            done < "$SDIR/EXCLUDE"
        fi
        parse_excludes "$INST" ${REC[@]+"${REC[@]}"} "${@:4}"
        take_locks "inst.$2.$3"
        containers_stopped "$3"
        echo "restore $2 $3 started $($DATE -u +%Y-%m-%dT%H:%M:%SZ) excludes=${#EXCLUDES[@]}" >> "$SDIR/JOURNAL" || refuse "cannot write $SDIR/JOURNAL"
        journal "restore-snapshot: $SDIR -> $INST started"
        # RESTORING marks an unfinished restore (e.g. a reboot mid-restore) for Ops and the
        # Console; at "done" it is renamed to RESTORED (no rm). Atlas review on #268.
        [[ ! -L "$SDIR/RESTORING" && ! -L "$SDIR/RESTORED" ]] || refuse "$SDIR/RESTORING is a symlink"
        echo "restoring $2 $3 since $($DATE -u +%Y-%m-%dT%H:%M:%SZ)" > "$SDIR/RESTORING" || refuse "cannot write $SDIR/RESTORING"
        # In place (idea#448): instances/<id> keeps its inode and is never moved. Excluded paths
        # (e.g. data/tailscale) are neither written, deleted nor moved, so their inodes survive.
        # Every live non-excluded file that rsync replaces or deletes is first put into ASIDE
        # (--backup-dir on the same filesystem: undoable, nothing removed).
        ASIDE=""
        if [[ -e "$INST" ]]; then
            existing_dir "$INST" "instance folder"
            QDIR="$R_DIR/.idea-quarantine"
            root_dir "$QDIR" 0700 "quarantine folder"
            $CHMOD 0700 -- "$QDIR" || refuse "cannot set mode 0700 on $QDIR"
            ASIDE="$QDIR/$3-before-restore-$($DATE -u +%Y%m%dT%H%M%S%NZ)"
            [[ ! -e "$ASIDE" && ! -L "$ASIDE" ]] || refuse "$ASIDE already exists"
            $MKDIR -m 0700 -- "$ASIDE" || refuse "cannot create $ASIDE"
            echo "restore $2 $3 aside=$ASIDE" >> "$SDIR/JOURNAL"
        else
            $MKDIR -m 0700 -- "$INST" || refuse "cannot create $INST"
        fi
        for rel in ${EXCLUDES[@]+"${EXCLUDES[@]}"}; do
            echo "restore exclude $rel" >> "$SDIR/JOURNAL"
        done
        pin_cwd "$SDIR/data"
        if [[ -n "$ASIDE" ]]; then
            run_child $RSYNC "${RSYNC_OPTS[@]}" --delete --backup "--backup-dir=$ASIDE" ${RSYNC_EXCL[@]+"${RSYNC_EXCL[@]}"} -- ./ "$INST/" || exit $?
        else
            run_child $RSYNC "${RSYNC_OPTS[@]}" ${RSYNC_EXCL[@]+"${RSYNC_EXCL[@]}"} -- ./ "$INST/" || exit $?
        fi
        if [[ -d "$SDIR/volumes" && ! -L "$SDIR/volumes" ]]; then
            ( cd "$SDIR/volumes" && $SHA256SUM -c --quiet -- SHA256SUMS ) >/dev/null 2>&1 || refuse "the volume archives of $3 do not match their checksums; not restoring volumes"
            for a in "$SDIR/volumes"/*.tar; do
                [[ -f "$a" && ! -L "$a" ]] || continue
                v=${a##*/}; v=${v%.tar}
                [[ "$v" =~ $RE_VOL ]] || refuse "archive name '$v' does not match $RE_VOL"
                if ! volume_exists "$v"; then
                    # Gone (e.g. compose down -v): recreate it as a local volume with the compose labels.
                    $DOCKER volume create --driver local --label "com.docker.compose.project=$3" \
                        --label "com.docker.compose.volume=${v#"$3"_}" -- "$v" >/dev/null || refuse "cannot recreate volume $v"
                    echo "restore volume $v recreated" >> "$SDIR/JOURNAL"
                    journal "restore-snapshot: volume $v recreated"
                fi
                volume_idle "$v"
                vd=$(volume_dir "$v") || exit 2
                # Current contents moved aside by a same-filesystem rename (undoable), never removed.
                vaside="$VOLUMES_DIR/$v/_data.idea-quarantine-$($DATE -u +%Y%m%dT%H%M%S%NZ)"
                MODE=$($STAT -c '%u:%g %a' -- "$vd") || refuse "cannot stat $vd"
                $MV -T -- "$vd" "$vaside" || refuse "cannot move $vd aside"
                $MKDIR -- "$vd" || refuse "cannot recreate $vd"
                $CHOWN "${MODE% *}" -- "$vd" 2>/dev/null || true
                $CHMOD "${MODE#* }" -- "$vd" || true
                run_child $TAR "${TAR_OPTS[@]}" -C "$vd" -xf "$a" || refuse "restore of volume $v failed (previous contents at $vaside)"
                echo "restore volume $v aside=$vaside" >> "$SDIR/JOURNAL"
                journal "restore-snapshot: volume $v restored (previous contents: $vaside)"
                echo "VOLUME $v $vaside"
            done
        fi
        echo "restore $2 $3 done aside=${ASIDE:-none}" >> "$SDIR/JOURNAL"
        $MV -T -- "$SDIR/RESTORING" "$SDIR/RESTORED" || refuse "cannot clear $SDIR/RESTORING"
        journal "restore-snapshot: $INST restored in place from $SDIR (replaced files: ${ASIDE:-none})"
        echo "${ASIDE:-none}"
        exit 0
        ;;

    estimate)
        # Read-only (no lock, nothing stopped or written): "<folder kb> <volumes kb> <free kb>"
        # so updateApp can refuse NO_SPACE before it stops anything; snapshot re-checks.
        # v14 (idea#396): optional excludes (the snapshot's rules); the folder kb is then net of
        # them, exactly as snapshot counts it. The two-argument call is unchanged.
        need_min 2 $(($# - 1)) "<root> <id> [exclude…]"
        check_id "$3"
        resolve_root "$2" instances
        INST=$(inst_dir "$R_DIR" "$3")
        [[ ! -L "$INST" ]] || refuse "$INST is a symlink"
        existing_dir "$INST" "instance folder"
        parse_snapshot_excludes "$INST" "${@:4}"
        list_volumes "$3"
        VOL_KB=0
        for v in ${VOL_NAMES[@]+"${VOL_NAMES[@]}"}; do
            vd=$(volume_dir "$v") || exit 2
            k=$(dir_kb "$vd"); [[ "$k" =~ ^[0-9]+$ ]] || refuse "cannot tell the size of volume $v"
            VOL_KB=$(( VOL_KB + k ))
        done
        INST_KB=$(dir_kb "$INST"); [[ "$INST_KB" =~ ^[0-9]+$ ]] || refuse "cannot tell the size of $INST"
        excluded_kb "$INST"
        INST_KB=$(( INST_KB > EXCL_KB ? INST_KB - EXCL_KB : 0 ))
        echo "$INST_KB $VOL_KB $(avail_kb "${R_DIR:-/}")"
        exit 0
        ;;

    snapshots)
        need 1 $(($# - 1)) "<root>"
        resolve_root "$2" instances
        PDIR="$R_DIR/.pre-update"
        QDIR="$R_DIR/.idea-quarantine"
        if [[ ! -e "$PDIR" ]]; then
            echo "TOTAL pre-update 0"
            if [[ -d "$QDIR" && ! -L "$QDIR" ]]; then echo "TOTAL quarantine $(dir_kb "$QDIR")"; else echo "TOTAL quarantine 0"; fi
            exit 0
        fi
        [[ ! -L "$PDIR" ]] || refuse "$PDIR is a symlink"
        for d in "$PDIR"/*/; do
            [[ -d "$d" && ! -L "${d%/}" ]] || continue
            n=${d%/}; n=${n##*/}
            [[ "$n" =~ $RE_ID ]] || continue
            kb=$($DU -sk -x -- "$d" | { read -r k _; echo "${k:-0}"; })
            if [[ -f "$d/COMPLETE" ]]; then echo "$n $kb complete"; else echo "$n $kb incomplete"; fi
        done
        echo "TOTAL pre-update $(dir_kb "$PDIR")"
        QDIR="$R_DIR/.idea-quarantine"
        if [[ -d "$QDIR" && ! -L "$QDIR" ]]; then echo "TOTAL quarantine $(dir_kb "$QDIR")"; else echo "TOTAL quarantine 0"; fi
        exit 0
        ;;

    quarantine-snapshot)
        # v14 (idea#396): the Engine calls this 24 h after an update passed its health gate.
        # One same-filesystem mv -T of .pre-update/<id> (complete or not) to
        # <same disk>/.idea-quarantine/<id>-pre-update-<UTC stamp>. Containers are not
        # stopped or inspected. A missing snapshot is exit 0 with nothing on stdout (a
        # retry after a move is this path); an existing destination is refused, never
        # overwritten. Nothing is ever removed.
        need 2 $(($# - 1)) "<root> <id>"
        check_id "$3"
        resolve_root "$2" instances
        PDIR="$R_DIR/.pre-update"
        SDIR="$PDIR/$3"
        QDIR="$R_DIR/.idea-quarantine"
        [[ ! -L "$PDIR" ]] || refuse "$PDIR is a symlink"
        [[ ! -L "$SDIR" ]] || refuse "$SDIR is a symlink"
        [[ ! -L "$QDIR" ]] || refuse "$QDIR is a symlink"
        if [[ ! -e "$SDIR" ]]; then
            echo "ok: $SDIR does not exist; nothing to quarantine" >&2
            exit 0
        fi
        existing_dir "$SDIR" "snapshot of $3"
        take_locks "inst.$2.$3"
        # Re-checked under the lock: a snapshot run that held it may have moved it already.
        [[ ! -L "$SDIR" ]] || refuse "$SDIR is a symlink"
        if [[ ! -e "$SDIR" ]]; then
            echo "ok: $SDIR does not exist; nothing to quarantine" >&2
            exit 0
        fi
        existing_dir "$SDIR" "snapshot of $3"
        if [[ -f "$SDIR/COMPLETE" && ! -L "$SDIR/COMPLETE" ]]; then STATE=complete; else STATE=incomplete; fi
        root_dir "$QDIR" 0700 "quarantine folder"
        $CHMOD 0700 -- "$QDIR" || refuse "cannot set mode 0700 on $QDIR"
        QDEST="$QDIR/$3-pre-update-$($DATE -u +%Y%m%dT%H%M%SZ)"
        [[ ! -e "$QDEST" && ! -L "$QDEST" ]] || refuse "$QDEST already exists"
        pin_cwd "$PDIR"
        $MV -T -- "./$3" "$QDEST" || refuse "cannot move $SDIR to $QDEST"
        $CHOWN root:root -- "$QDEST" 2>/dev/null || true
        $CHMOD 0700 -- "$QDEST" || true
        journal "quarantine-snapshot: $SDIR -> $QDEST ($STATE)"
        echo "$QDEST"
        exit 0
        ;;

    borg-init)
        need 2 $(($# - 1)) "<bdev> <id>"
        check_id "$3"
        resolve_root "$2" backup
        existing_dir "$R_DIR/backups" "backups folder"
