# /etc/sudoers.d/11-engine-files: installed by build-engine (installUdev -> installEngineSudoers),
# mode 0440, owner root:root. Validate with: visudo -cf <file>
#
# Files and folders the Engine (running as pi under pm2) writes, removes or changes
# the owner of as root under /disks (idea#121, idea#126, idea#131). 10-engine lists
# the Engine's other root commands and is not changed by this file.
# Keep this file in sync with the code:
#   META.yaml    src/data/Meta.ts (writeMetaFile, runSudoTee: first dock of a disk
#                without META.yaml; the mount roots under /disks are root:root)
#   mount point  src/monitors/mounts.ts (removeMountPointFolder: undock and startup
#                cleanup remove /disks/<device> after `mountpoint -q` says it is no
#                longer a mount point; never rm -fr)
#   root owner   src/data/CreateFilesDisk.ts (runSudoChownRoot: createFilesDisk, only
#                when pi can't write the disk root; the previous uid:gid and mode go
#                into the command trace first; idea#131, Files Disk step 1)
#   erase disk   /usr/local/sbin/idea-erase-disk (idea#134): no argument list; the
#                script validates device/serial/size/label/staging itself
#   typed mount  src/monitors/mounts.ts (safeMount): exactly
#                /usr/bin/mount -t ext4 /dev/<dev> /disks/<dev> (idea#134)
#                /usr/bin/mount -t ext4 -o ro,noload /dev/<dev> /disks/<dev>: read-only look
#                for META.yaml before any rw mount (idea#201 §10 rule 1)
#   app data     /usr/local/sbin/idea-app-data (idea#168): no argument list; the helper
#                validates subcommand, device, instance id, archive, host and paths itself
#                (src/utils/appDataHelper.ts, src/utils/rsync.ts rsyncInstanceData:
#                size/copy/send/receive/delete/borg-* of app INSTANCE data as root)
#   usb sticks   src/data/UsbSticks.ts (idea#193): teacher FAT/exFAT sticks, typed,
#                read-only, exactly these options, only under /run/idea-usb (never
#                /disks). /run/idea-usb is pi:pi 0755 from /etc/tmpfiles.d/idea-usb.conf,
#                so the mount point folders need no sudo. umount -l only when busy.
#
# The code runs `sudo /usr/bin/tee /disks/<device>/META.yaml > /dev/null` with the
# YAML on stdin, so sudo sees exactly "/usr/bin/tee /disks/<device>/META.yaml", and
# `sudo /usr/bin/rmdir /disks/<device>`, so sudo sees exactly that. rmdir only
# removes an empty folder, so it can never delete a disk's data.
# createFilesDisk runs `sudo /usr/bin/chown -h pi:pi /disks/<device>`: the disk root
# folder only, not recursive (no -R), and -h changes a symlink itself, never what it
# points to. The ':' is escaped as '\:' because it is special in sudoers.
# Patterns are narrow on purpose (sd[a-z][1-9], never /disks/*): in sudoers a '*' in
# arguments also matches spaces, '/' and '..'. tee without -a truncates the file.
# In the stick mount lines ',' and '=' inside -o are escaped as '\,' and '\=' (sudoers
# special characters); sudo matches them as plain ',' and '='.
# Paths are for Raspberry Pi OS (merged /usr).
pi ALL=(root) NOPASSWD: /usr/bin/tee /disks/sd[a-z][1-9]/META.yaml
pi ALL=(root) NOPASSWD: /usr/bin/rmdir /disks/sd[a-z][1-9]
pi ALL=(root) NOPASSWD: /usr/bin/chown -h pi\:pi /disks/sd[a-z][1-9]
pi ALL=(root) NOPASSWD: /usr/local/sbin/idea-erase-disk
# idea#201 §10: client-card flash helper (validates every argument itself)
pi ALL=(root) NOPASSWD: /usr/local/sbin/idea-flash-card
pi ALL=(root) NOPASSWD: /usr/local/sbin/idea-app-data
pi ALL=(root) NOPASSWD: /usr/bin/mount -t ext4 /dev/sd[a-z][1-9] /disks/sd[a-z][1-9]
pi ALL=(root) NOPASSWD: /usr/bin/mount -t ext4 -o ro\,noload /dev/sd[a-z][1-9] /disks/sd[a-z][1-9]
pi ALL=(root) NOPASSWD: /usr/bin/mount -t vfat -o ro\,nosuid\,nodev\,noexec\,uid\=1000\,gid\=1000\,fmask\=0222\,dmask\=0222\,iocharset\=utf8\,shortname\=mixed /dev/sd[a-z][12] /run/idea-usb/sd[a-z][12]
pi ALL=(root) NOPASSWD: /usr/bin/mount -t vfat -o ro\,nosuid\,nodev\,noexec\,uid\=1000\,gid\=1000\,fmask\=0222\,dmask\=0222\,iocharset\=utf8\,shortname\=mixed /dev/sd[a-z] /run/idea-usb/sd[a-z]
pi ALL=(root) NOPASSWD: /usr/bin/mount -t exfat -o ro\,nosuid\,nodev\,noexec\,uid\=1000\,gid\=1000\,fmask\=0222\,dmask\=0222\,iocharset\=utf8 /dev/sd[a-z][12] /run/idea-usb/sd[a-z][12]
pi ALL=(root) NOPASSWD: /usr/bin/mount -t exfat -o ro\,nosuid\,nodev\,noexec\,uid\=1000\,gid\=1000\,fmask\=0222\,dmask\=0222\,iocharset\=utf8 /dev/sd[a-z] /run/idea-usb/sd[a-z]
pi ALL=(root) NOPASSWD: /usr/bin/umount /run/idea-usb/sd[a-z][12], /usr/bin/umount /run/idea-usb/sd[a-z]
pi ALL=(root) NOPASSWD: /usr/bin/umount -l /run/idea-usb/sd[a-z][12], /usr/bin/umount -l /run/idea-usb/sd[a-z]
# idea#76 fixture / partitions 3+: 10-engine.sudoers covers only sd[a-z][12] and is
# not edited, so the same mount-point and serial commands for partitions 3-9 live here.
pi ALL=(root) NOPASSWD: /usr/bin/umount /disks/sd[a-z][3-9]
pi ALL=(root) NOPASSWD: /usr/bin/mkdir -p /disks/sd[a-z][3-9]
pi ALL=(root) NOPASSWD: /usr/bin/mv /disks/sd[a-z][3-9] /disks/old/sd[a-z][3-9]
pi ALL=(root) NOPASSWD: /usr/bin/rm -fr /disks/sd[a-z][3-9]
pi ALL=(root) NOPASSWD: /usr/sbin/hdparm -I /dev/sd[a-z][3-9]
